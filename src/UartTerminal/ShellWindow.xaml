<Window x:Class="UartTerminal.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:UartTerminal"
        Title="UartTerminal" Height="620" Width="1020"
        Icon="/UartTerminal.ico"
        Background="{DynamicResource Bg}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <!-- 탭 닫기(×) 버튼 -->
        <Style x:Key="TabCloseButton" TargetType="Button">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource TextFaint}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="cb" Background="Transparent" CornerRadius="4">
                            <TextBlock Text="&#x2715;" FontSize="{StaticResource Font.Glyph}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cb" Property="Background" Value="{DynamicResource Red}"/>
                                <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- COM 포트 탭 헤더(둥근 상단, GitHub-dark) -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextMuted}"/>
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Margin="0,3,4,-1" Padding="11,7"
                                CornerRadius="8,8,0,0"
                                Background="{DynamicResource TabIdle}"
                                BorderBrush="{DynamicResource BorderBrush2}"
                                BorderThickness="1,1,1,0">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource Bg}"/>
                                <Setter Property="Foreground" Value="{DynamicResource Text}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SurfaceHover}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 탭 스트립(헤더 전용; 콘텐츠는 아래 ContentHost) -->
        <Style TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Border Background="Transparent" BorderThickness="0" Padding="8,5,8,0">
                            <TabPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top"
              Padding="6,2" BorderThickness="0,0,0,1" BorderBrush="{DynamicResource BorderBrush2}">
            <!--
              메뉴 구성 원칙
               - 최상위는 '관심사' 단위: 연결(터미널) / 편집 / 보기 / 보드 제어 / 창·레이아웃 / 명령 / MCP / 도움말
               - 접근키는 최상위에서 전부 유니크(T E V D W C M H)하고, 각 메뉴 안에서도 중복되지 않게 배정한다.
               - 전역 Alt 단축키(Alt+N/I/B/R, Alt+Shift+R)와 겹치는 글자는 접근키로 쓸 수 없다
                 (창 PreviewKeyDown 이 먼저 처리해 메뉴가 열리지 않는다). 그래서 '보드'는 _B 가 아니라 _D.
            -->
            <!-- SubmenuOpened: 로깅 시작/정지 문구·체크 상태를 열 때마다 활성 탭 기준으로 동기화 -->
            <MenuItem Header="{loc:Str Menu.Terminal}" SubmenuOpened="TerminalMenu_Opened">
                <MenuItem Header="{loc:Str Menu.NewTab}" InputGestureText="Ctrl+T" Click="NewTab_Click"/>
                <MenuItem Header="{loc:Str Menu.Reconnect}" InputGestureText="Alt+N" Click="Reconnect_Click"/>
                <MenuItem Header="{loc:Str Menu.Disconnect}" InputGestureText="Alt+I" Click="Disconnect_Click"/>
                <MenuItem x:Name="MenuAutoReconnect" Header="{loc:Str Menu.AutoReconnect}"
                          IsCheckable="True" Click="AutoReconnect_Click"/>
                <Separator/>
                <!-- 개행은 회선 설정과 같은 '통신 규약'이라 연결 메뉴에 둔다(서브메뉴로 1줄만 차지) -->
                <MenuItem Header="{loc:Str Menu.Newline}">
                    <MenuItem Header="{loc:Str Menu.Newline.Rx}">
                        <MenuItem x:Name="MenuRxCrLf" Header="{loc:Str Menu.Newline.RxCrLf}"
                                  IsCheckable="True" Click="NewlineRx_Click" Tag="CrLf"/>
                        <MenuItem x:Name="MenuRxLf" Header="{loc:Str Menu.Newline.RxLf}"
                                  IsCheckable="True" Click="NewlineRx_Click" Tag="Lf"/>
                        <MenuItem x:Name="MenuRxCr" Header="{loc:Str Menu.Newline.RxCr}"
                                  IsCheckable="True" Click="NewlineRx_Click" Tag="Cr"/>
                        <MenuItem x:Name="MenuRxAuto" Header="{loc:Str Menu.Newline.RxAuto}"
                                  IsCheckable="True" Click="NewlineRx_Click" Tag="Auto"/>
                    </MenuItem>
                    <MenuItem Header="{loc:Str Menu.Newline.Tx}">
                        <MenuItem x:Name="MenuTxCr" Header="{loc:Str Menu.Newline.TxCr}"
                                  IsCheckable="True" Click="NewlineTx_Click" Tag="Cr"/>
                        <MenuItem x:Name="MenuTxCrLf" Header="{loc:Str Menu.Newline.TxCrLf}" IsCheckable="True" Click="NewlineTx_Click" Tag="CrLf"/>
                        <MenuItem x:Name="MenuTxLf" Header="{loc:Str Menu.Newline.TxLf}" IsCheckable="True" Click="NewlineTx_Click" Tag="Lf"/>
                    </MenuItem>
                </MenuItem>
                <Separator/>
                <MenuItem Header="{loc:Str Menu.SaveSession}" Click="SaveSession_Click"/>
                <MenuItem Header="{loc:Str Menu.ManageSessions}" Click="ManageSessions_Click"/>
                <Separator/>
                <MenuItem Header="{loc:Str Menu.SaveLog}" Click="SaveLog_Click"/>
                <!-- 연속 로깅(TeraTerm 의 Log). 옵션(쓰기 모드·타임스탬프·화면 버퍼)은 시작 다이얼로그에서 고른다 -->
                <MenuItem x:Name="MenuLogToggle" Header="{loc:Str Menu.LogStart}" Click="LogToggle_Click"/>
                <Separator/>
                <MenuItem Header="{loc:Str Menu.CloseTab}" InputGestureText="Ctrl+W" Click="CloseTab_Click"/>
                <MenuItem Header="{loc:Str Menu.Exit}" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="{loc:Str Menu.Edit}">
                <MenuItem Header="{loc:Str Menu.Copy}" InputGestureText="Ctrl+Ins" Click="Copy_Click"/>
                <MenuItem Header="{loc:Str Menu.Paste}" InputGestureText="{loc:Str Gesture.Paste}" Click="Paste_Click"/>
                <Separator/>
                <MenuItem Header="{loc:Str Menu.Find}" InputGestureText="Ctrl+F" Click="Find_Click"/>
                <Separator/>
                <MenuItem Header="{loc:Str Menu.ClearScreen}" Click="ClearScreen_Click"/>
                <MenuItem Header="{loc:Str Menu.ClearBuffer}" Click="ClearBuffer_Click"/>
            </MenuItem>
            <MenuItem Header="{loc:Str Menu.View}">
                <MenuItem Header="{loc:Str Menu.FontLarger}" InputGestureText="{loc:Str Gesture.FontLarger}" Click="FontLarger_Click"/>
                <MenuItem Header="{loc:Str Menu.FontSmaller}" InputGestureText="{loc:Str Gesture.FontSmaller}" Click="FontSmaller_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuTimestamps" Header="{loc:Str Menu.Timestamps}" IsCheckable="True" Click="Timestamps_Click"/>
                <MenuItem x:Name="MenuParsePanel" Header="{loc:Str Menu.ParsePanel}" IsCheckable="True" Click="ParsePanel_Click"/>
                <Separator/>
                <MenuItem Header="{loc:Str Menu.Language}">
                    <MenuItem x:Name="MenuLangKo" Header="{loc:Str Menu.Language.Korean}" IsCheckable="True" Click="Language_Click" Tag="Korean"/>
                    <MenuItem x:Name="MenuLangEn" Header="{loc:Str Menu.Language.English}" IsCheckable="True" Click="Language_Click" Tag="English"/>
                </MenuItem>
                <Separator/>
                <MenuItem Header="{loc:Str Menu.ScrollEnd}" InputGestureText="Ctrl+End" Click="ScrollEnd_Click"/>
            </MenuItem>
            <!-- 보드 제어: ESP32 devkit 의 DTR→IO0 / RTS→EN 자동 리셋 회로 (README §2.2) -->
            <MenuItem Header="{loc:Str Menu.Board}">
                <MenuItem Header="{loc:Str Menu.HardReset}" InputGestureText="Alt+R" Click="HardReset_Click"/>
                <MenuItem Header="{loc:Str Menu.Bootloader}" InputGestureText="Alt+Shift+R" Click="Bootloader_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuResetOnOpen" Header="{loc:Str Menu.ResetOnOpen}"
                          IsCheckable="True" Click="ResetOnOpen_Click"/>
                <Separator/>
                <MenuItem Header="{loc:Str Menu.Flash}" Click="Flash_Click"/>
            </MenuItem>
            <!-- 창·레이아웃: 탭 분리/합치기와 화면 분할은 같은 관심사라 한 메뉴에 모은다 -->
            <MenuItem Header="{loc:Str Menu.Window}">
                <MenuItem Header="{loc:Str Menu.Detach}" Click="Detach_Click"/>
                <MenuItem Header="{loc:Str Menu.Merge}" Click="Merge_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuSplitSingle" Header="{loc:Str Menu.SplitSingle}" IsCheckable="True" Click="SplitSingle_Click"/>
                <MenuItem x:Name="MenuSplitV" Header="{loc:Str Menu.SplitV}" IsCheckable="True" Click="SplitV_Click"/>
                <MenuItem x:Name="MenuSplitH" Header="{loc:Str Menu.SplitH}" IsCheckable="True" Click="SplitH_Click"/>
                <MenuItem x:Name="MenuSplitGrid" Header="{loc:Str Menu.SplitGrid}" IsCheckable="True" Click="SplitGrid_Click"/>
            </MenuItem>
            <MenuItem Header="{loc:Str Menu.Command}">
                <MenuItem x:Name="MenuCommandBar" Header="{loc:Str Menu.CommandBar}" InputGestureText="Alt+B"
                          IsCheckable="True" Click="CommandBar_Click"/>
                <Separator/>
                <MenuItem Header="{loc:Str Menu.SaveCommand}" Click="SaveCommand_Click"/>
                <MenuItem Header="{loc:Str Menu.EditCommands}" Click="EditCommands_Click"/>
            </MenuItem>
            <MenuItem Header="{loc:Str Menu.Mcp}">
                <MenuItem x:Name="MenuMcpEnabled" Header="{loc:Str Menu.McpEnabled}" IsCheckable="True"
                          Click="McpEnabled_Click"/>
                <MenuItem x:Name="MenuMcpReadOnly" Header="{loc:Str Menu.McpReadOnly}" IsCheckable="True"
                          Click="McpReadOnly_Click"/>
                <Separator/>
                <MenuItem Header="{loc:Str Menu.McpCopyCmd}" Click="McpCopyCmd_Click"/>
            </MenuItem>
            <MenuItem Header="{loc:Str Menu.Help}">
                <MenuItem x:Name="MenuDiagCapture" Header="{loc:Str Menu.DiagCapture}"
                          IsCheckable="True" Click="DiagCapture_Click"/>
                <Separator/>
                <MenuItem Header="{loc:Str Menu.About}" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- 세그먼트 상태바 -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource StatusBarPanel}">
            <Grid Margin="12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="ConnDot" Width="7" Height="7" Fill="{DynamicResource Idle}" Margin="0,0,7,0"/>
                    <!-- 로그 경로가 실릴 때만 링크가 된다(밑줄·손모양은 코드에서 켜고 끈다).
                         Background=Transparent 이 없으면 TextBlock 은 히트 테스트에서 빠져 클릭이 아예 오지 않는다. -->
                    <TextBlock x:Name="StatusText" Style="{StaticResource StatusText}"
                               Background="Transparent"
                               Foreground="{DynamicResource Text}" Text="{loc:Str Status.Starting}"
                               MouseLeftButtonUp="StatusText_MouseLeftButtonUp"/>
                    <Rectangle Style="{StaticResource StatusDivider}" Margin="14,0"/>
                    <TextBlock x:Name="McpStatusText" Style="{StaticResource StatusText}" Text="{loc:Str Status.McpOff}"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="MetricsText" Style="{StaticResource StatusText}" Text=""/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 탭 스트립 + 화면 분할 아이콘 툴바(오른쪽 알약) -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource BgPanel}"
                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TabControl x:Name="Tabs" Grid.Column="0" BorderThickness="0"
                            SelectionChanged="Tabs_SelectionChanged"/>
                <Border Grid.Column="1" Style="{StaticResource SplitToolbar}"
                        VerticalAlignment="Center" Margin="6,4,10,6">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="BtnSplitSingle" Style="{StaticResource SplitToggle}"
                                      Tag="{StaticResource Ic.Single}" Click="SplitSingle_Click" ToolTip="{loc:Str Tip.SplitSingle}"/>
                        <ToggleButton x:Name="BtnSplitV" Style="{StaticResource SplitToggle}"
                                      Tag="{StaticResource Ic.SplitV}" Click="SplitV_Click" ToolTip="{loc:Str Tip.SplitV}"/>
                        <ToggleButton x:Name="BtnSplitH" Style="{StaticResource SplitToggle}"
                                      Tag="{StaticResource Ic.SplitH}" Click="SplitH_Click" ToolTip="{loc:Str Tip.SplitH}"/>
                        <ToggleButton x:Name="BtnSplitGrid" Style="{StaticResource SplitToggle}"
                                      Tag="{StaticResource Ic.Grid}" Click="SplitGrid_Click" ToolTip="{loc:Str Tip.SplitGrid}"/>
                        <Rectangle Width="1" Height="14" Margin="4,0" Fill="{DynamicResource BorderStrong}" VerticalAlignment="Center"/>
                        <ToggleButton x:Name="BtnParsePanel" Style="{StaticResource SplitToggle}"
                                      Tag="{StaticResource Ic.Parse}" Click="ParsePanel_Click" ToolTip="{loc:Str Tip.ParsePanel}"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 실제 문서(터미널) 렌더 영역: 탭 모드=활성 1개, 분할 모드=격자 배치 -->
        <Grid x:Name="ContentHost" Background="{DynamicResource Bg}"/>
    </DockPanel>
</Window>
