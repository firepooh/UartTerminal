<Window x:Class="UartTerminal.ShellWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UartTerminal" Height="620" Width="1020"
        Icon="/UartTerminal.ico"
        Background="{StaticResource Bg}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Window.Resources>
        <!-- 탭 닫기(×) 버튼 -->
        <Style x:Key="TabCloseButton" TargetType="Button">
            <Setter Property="Width" Value="16"/>
            <Setter Property="Height" Value="16"/>
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{StaticResource TextFaint}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="cb" Background="Transparent" CornerRadius="4">
                            <TextBlock Text="&#x2715;" FontSize="10"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="cb" Property="Background" Value="{StaticResource Red}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- COM 포트 탭 헤더(둥근 상단, GitHub-dark) -->
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{StaticResource TextMuted}"/>
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="Bd" Margin="0,3,4,-1" Padding="11,7"
                                CornerRadius="8,8,0,0"
                                Background="{StaticResource TabIdle}"
                                BorderBrush="{StaticResource BorderBrush2}"
                                BorderThickness="1,1,1,0">
                            <ContentPresenter ContentSource="Header" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Bg}"/>
                                <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsSelected" Value="False"/>
                                    <Condition Property="IsMouseOver" Value="True"/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource SurfaceHover}"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 탭 스트립(헤더 전용; 콘텐츠는 아래 ContentHost) -->
        <Style TargetType="TabControl">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Border Background="Transparent" BorderThickness="0" Padding="8,5,8,0">
                            <TabPanel IsItemsHost="True"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <DockPanel>
        <Menu DockPanel.Dock="Top"
              Padding="6,2" BorderThickness="0,0,0,1" BorderBrush="{StaticResource BorderBrush2}">
            <!--
              메뉴 구성 원칙
               - 최상위는 '관심사' 단위: 연결(터미널) / 편집 / 보기 / 보드 제어 / 창·레이아웃 / 명령 / MCP / 도움말
               - 접근키는 최상위에서 전부 유니크(T E V D W C M H)하고, 각 메뉴 안에서도 중복되지 않게 배정한다.
               - 전역 Alt 단축키(Alt+N/I/B/R, Alt+Shift+R)와 겹치는 글자는 접근키로 쓸 수 없다
                 (창 PreviewKeyDown 이 먼저 처리해 메뉴가 열리지 않는다). 그래서 '보드'는 _B 가 아니라 _D.
            -->
            <MenuItem Header="터미널(_T)">
                <MenuItem Header="새 연결(탭 추가)(_N)" InputGestureText="Ctrl+T" Click="NewTab_Click"/>
                <MenuItem Header="재연결(_R)…" InputGestureText="Alt+N" Click="Reconnect_Click"/>
                <MenuItem Header="연결 해제(_D)" InputGestureText="Alt+I" Click="Disconnect_Click"/>
                <MenuItem x:Name="MenuAutoReconnect" Header="자동 재연결 (USB 재접속 시)(_A)"
                          IsCheckable="True" Click="AutoReconnect_Click"/>
                <Separator/>
                <!-- 개행은 회선 설정과 같은 '통신 규약'이라 연결 메뉴에 둔다(서브메뉴로 1줄만 차지) -->
                <MenuItem Header="개행(New-line)(_L)">
                    <MenuItem Header="수신(Receive)">
                        <MenuItem x:Name="MenuRxCrLf" Header="CR+LF  — 개행=LF, CR=줄 처음으로(기본)"
                                  IsCheckable="True" Click="NewlineRx_Click" Tag="CrLf"/>
                        <MenuItem x:Name="MenuRxLf" Header="LF  — 개행=LF, CR 무시"
                                  IsCheckable="True" Click="NewlineRx_Click" Tag="Lf"/>
                        <MenuItem x:Name="MenuRxCr" Header="CR  — 개행=CR, LF 무시"
                                  IsCheckable="True" Click="NewlineRx_Click" Tag="Cr"/>
                        <MenuItem x:Name="MenuRxAuto" Header="AUTO  — CR/LF/CR+LF 모두 개행"
                                  IsCheckable="True" Click="NewlineRx_Click" Tag="Auto"/>
                    </MenuItem>
                    <MenuItem Header="송신(Transmit)">
                        <MenuItem x:Name="MenuTxCr" Header="CR  — esp_console 기본"
                                  IsCheckable="True" Click="NewlineTx_Click" Tag="Cr"/>
                        <MenuItem x:Name="MenuTxCrLf" Header="CR+LF" IsCheckable="True" Click="NewlineTx_Click" Tag="CrLf"/>
                        <MenuItem x:Name="MenuTxLf" Header="LF" IsCheckable="True" Click="NewlineTx_Click" Tag="Lf"/>
                    </MenuItem>
                </MenuItem>
                <Separator/>
                <MenuItem Header="현재 연결을 세션으로 저장(_S)…" Click="SaveSession_Click"/>
                <MenuItem Header="세션 관리(_G)…" Click="ManageSessions_Click"/>
                <Separator/>
                <MenuItem Header="로그 저장(_V)…" Click="SaveLog_Click"/>
                <Separator/>
                <MenuItem Header="탭 닫기(_W)" InputGestureText="Ctrl+W" Click="CloseTab_Click"/>
                <MenuItem Header="종료(_X)" Click="Exit_Click"/>
            </MenuItem>
            <MenuItem Header="편집(_E)">
                <MenuItem Header="복사(_C)" InputGestureText="Ctrl+Ins" Click="Copy_Click"/>
                <MenuItem Header="붙여넣기(_P)" InputGestureText="Shift+Ins / 우클릭" Click="Paste_Click"/>
                <Separator/>
                <MenuItem Header="찾기(_F)…" InputGestureText="Ctrl+F" Click="Find_Click"/>
                <Separator/>
                <MenuItem Header="화면 지우기(_S)" Click="ClearScreen_Click"/>
                <MenuItem Header="버퍼 지우기(_B)" Click="ClearBuffer_Click"/>
            </MenuItem>
            <MenuItem Header="보기(_V)">
                <MenuItem Header="폰트 크게(_I)" InputGestureText="Ctrl++ / Ctrl+휠" Click="FontLarger_Click"/>
                <MenuItem Header="폰트 작게(_O)" InputGestureText="Ctrl+- / Ctrl+휠" Click="FontSmaller_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuTimestamps" Header="타임스탬프 표시(_T)" IsCheckable="True" Click="Timestamps_Click"/>
                <Separator/>
                <MenuItem Header="맨 아래로(_E)" InputGestureText="Ctrl+End" Click="ScrollEnd_Click"/>
            </MenuItem>
            <!-- 보드 제어: ESP32 devkit 의 DTR→IO0 / RTS→EN 자동 리셋 회로 (README §2.2) -->
            <MenuItem Header="보드(_D)">
                <MenuItem Header="하드웨어 리셋 (EN 펄스)(_R)" InputGestureText="Alt+R" Click="HardReset_Click"/>
                <MenuItem Header="부트로더 모드 진입 (IO0=LOW)(_L)" InputGestureText="Alt+Shift+R" Click="Bootloader_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuResetOnOpen" Header="열 때 보드 리셋 (이 탭 · 세션에 저장)(_O)"
                          IsCheckable="True" Click="ResetOnOpen_Click"/>
            </MenuItem>
            <!-- 창·레이아웃: 탭 분리/합치기와 화면 분할은 같은 관심사라 한 메뉴에 모은다 -->
            <MenuItem Header="창(_W)">
                <MenuItem Header="새 창으로 분리(_D)" Click="Detach_Click"/>
                <MenuItem Header="메인 창으로 합치기(_M)" Click="Merge_Click"/>
                <Separator/>
                <MenuItem x:Name="MenuSplitSingle" Header="단일 화면(_1)" IsCheckable="True" Click="SplitSingle_Click"/>
                <MenuItem x:Name="MenuSplitV" Header="좌우 분할(_2)" IsCheckable="True" Click="SplitV_Click"/>
                <MenuItem x:Name="MenuSplitH" Header="상하 분할(_3)" IsCheckable="True" Click="SplitH_Click"/>
                <MenuItem x:Name="MenuSplitGrid" Header="격자 분할(_4)" IsCheckable="True" Click="SplitGrid_Click"/>
            </MenuItem>
            <MenuItem Header="명령(_C)">
                <MenuItem x:Name="MenuCommandBar" Header="명령 바 표시(_S)" InputGestureText="Alt+B"
                          IsCheckable="True" Click="CommandBar_Click"/>
                <Separator/>
                <MenuItem Header="현재 입력을 명령으로 저장(_A)" Click="SaveCommand_Click"/>
                <MenuItem Header="저장 명령 편집(_E)…" Click="EditCommands_Click"/>
            </MenuItem>
            <MenuItem Header="MCP(_M)">
                <MenuItem x:Name="MenuMcpEnabled" Header="MCP 서버 활성화(_E)" IsCheckable="True"
                          Click="McpEnabled_Click"/>
                <MenuItem x:Name="MenuMcpReadOnly" Header="AI 읽기 전용 (TX·제어선 차단)(_R)" IsCheckable="True"
                          Click="McpReadOnly_Click"/>
                <Separator/>
                <MenuItem Header="등록 명령 복사 (claude mcp add)(_C)" Click="McpCopyCmd_Click"/>
            </MenuItem>
            <MenuItem Header="도움말(_H)">
                <MenuItem x:Name="MenuDiagCapture" Header="진단 캡처 (RX/TX → diag.log)(_D)"
                          IsCheckable="True" Click="DiagCapture_Click"/>
                <Separator/>
                <MenuItem Header="UartTerminal 정보(_A)" Click="About_Click"/>
            </MenuItem>
        </Menu>

        <!-- 세그먼트 상태바 -->
        <Border DockPanel.Dock="Bottom" Style="{StaticResource StatusBarPanel}">
            <Grid Margin="12,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse x:Name="ConnDot" Width="7" Height="7" Fill="{StaticResource Idle}" Margin="0,0,7,0"/>
                    <TextBlock x:Name="StatusText" Style="{StaticResource StatusText}"
                               Foreground="{StaticResource Text}" Text="시작 중…"/>
                    <Rectangle Style="{StaticResource StatusDivider}" Margin="14,0"/>
                    <TextBlock x:Name="McpStatusText" Style="{StaticResource StatusText}" Text="MCP: 꺼짐"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="MetricsText" Style="{StaticResource StatusText}" Text=""/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 탭 스트립 + 화면 분할 아이콘 툴바(오른쪽 알약) -->
        <Border DockPanel.Dock="Top" Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TabControl x:Name="Tabs" Grid.Column="0" BorderThickness="0"
                            SelectionChanged="Tabs_SelectionChanged"/>
                <Border Grid.Column="1" Style="{StaticResource SplitToolbar}"
                        VerticalAlignment="Center" Margin="6,4,10,6">
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="BtnSplitSingle" Style="{StaticResource SplitToggle}"
                                      Tag="{StaticResource Ic.Single}" Click="SplitSingle_Click" ToolTip="단일 화면"/>
                        <ToggleButton x:Name="BtnSplitV" Style="{StaticResource SplitToggle}"
                                      Tag="{StaticResource Ic.SplitV}" Click="SplitV_Click" ToolTip="좌우 분할"/>
                        <ToggleButton x:Name="BtnSplitH" Style="{StaticResource SplitToggle}"
                                      Tag="{StaticResource Ic.SplitH}" Click="SplitH_Click" ToolTip="상하 분할"/>
                        <ToggleButton x:Name="BtnSplitGrid" Style="{StaticResource SplitToggle}"
                                      Tag="{StaticResource Ic.Grid}" Click="SplitGrid_Click" ToolTip="격자 분할"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- 실제 문서(터미널) 렌더 영역: 탭 모드=활성 1개, 분할 모드=격자 배치 -->
        <Grid x:Name="ContentHost" Background="{StaticResource Bg}"/>
    </DockPanel>
</Window>
