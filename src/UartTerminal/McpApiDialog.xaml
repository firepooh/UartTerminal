<Window x:Class="UartTerminal.McpApiDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:UartTerminal"
        Title="{loc:Str McpApi.Title}"
        Icon="/UartTerminal.ico"
        Width="720" Height="680"
        MinWidth="520" MinHeight="360"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BgPanel}"
        Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource UiFont}">

    <!--
      내용을 XAML 에 적지 않고 코드가 UartMcpTools 에서 뽑아 채운다 —
      손으로 옮겨 적으면 도구가 바뀔 때 조용히 어긋나고, 이 화면에서 알고 싶은 것은
      "AI 가 실제로 받는 것" 이기 때문이다. 여기서는 틀만 둔다.

      길이가 뻔히 길어서 SizeToContent 를 쓰지 않는다(창이 화면을 넘는다).
      대신 고정 높이 + 스크롤, 그리고 참고용 창이므로 크기 조절을 허용한다.
    -->
    <DockPanel Margin="18">

        <StackPanel DockPanel.Dock="Top">
            <TextBlock x:Name="IntroText" Style="{StaticResource HintText}" TextWrapping="Wrap"/>
            <!-- 이름만 먼저 한 줄에 — uart_expect 처럼 설명이 긴 도구가 첫 화면을 다 먹으면
                 "무슨 도구가 있나" 를 훑을 수가 없다. 상세는 아래 카드에서 본다. -->
            <Border Style="{StaticResource InsetPanel}" Margin="0,10,0,0" Padding="12,10">
                <WrapPanel x:Name="Summary"/>
            </Border>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="{loc:Str Common.Close}" Style="{StaticResource SendButton}"
                    MinWidth="86" MinHeight="30" IsCancel="True" IsDefault="True"/>
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,14,0,0">
            <StackPanel x:Name="Body" Margin="0,0,10,0"/>
        </ScrollViewer>
    </DockPanel>
</Window>
