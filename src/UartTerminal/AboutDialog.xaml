<Window x:Class="UartTerminal.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:UartTerminal"
        Title="{loc:Str About.Title}"
        Icon="/UartTerminal.ico"
        Width="440" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{DynamicResource Bg}"
        FontFamily="{StaticResource UiFont}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType">
    <Grid Margin="22,20">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Image Grid.Column="0" Source="/UartTerminal.ico" Width="56" Height="56"
               VerticalAlignment="Top" Margin="0,2,18,0" RenderOptions.BitmapScalingMode="HighQuality"/>

        <StackPanel Grid.Column="1">
            <TextBlock Text="UartTerminal" FontSize="{StaticResource Font.Title}" FontWeight="Bold"
                       Foreground="{DynamicResource Text}"/>
            <TextBlock x:Name="VersionText" Margin="0,3,0,0"
                       FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource Font.Body}"
                       Foreground="{DynamicResource TextMuted}"/>

            <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" FontSize="{StaticResource Font.Body}" LineHeight="18"
                       Foreground="{DynamicResource TextDim}"
                       Text="{loc:Str About.Summary}"/>

            <TextBlock x:Name="RuntimeText" Margin="0,12,0,0" FontSize="{StaticResource Font.Caption}"
                       Foreground="{DynamicResource TextFaint}"/>
            <TextBlock Margin="0,3,0,0" FontSize="{StaticResource Font.Caption}">
                <Hyperlink x:Name="RepoLink" Click="Repo_Click"
                           Foreground="{DynamicResource Blue}" TextDecorations="{x:Null}">github.com/firepooh/UartTerminal</Hyperlink>
            </TextBlock>

            <Button x:Name="OkButton" Content="{loc:Str Common.Ok}" Width="90" Height="30"
                    Margin="0,20,0,0" HorizontalAlignment="Right"
                    IsDefault="True" IsCancel="True" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
