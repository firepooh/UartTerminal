<Window x:Class="UartTerminal.SessionManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:UartTerminal"
        Title="{loc:Str Sess.Title}"
        Icon="/UartTerminal.ico"
        Width="900" Height="600" MinWidth="740" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BgPanel}"
        Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <!-- 표 셀 텍스트: 선택된 행(파란 배경)에서는 흰색으로 바꿔 대비를 유지한다.
             (열마다 색을 직접 지정하면 ListBoxItem 의 선택 시 Foreground 상속이 덮여 파란 글씨가 파란 배경에 묻는다) -->
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CellPort" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="Foreground" Value="{DynamicResource Blue}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CellBaud" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextDim}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CellGroup" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="Foreground" Value="{Binding GroupBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 열 때 동작(리셋·MCP): 켜진 항목만 눈에 띄게(둘 다 꺼짐은 흐린 "—") -->
        <Style x:Key="CellOnOpen" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="Foreground" Value="{Binding OnOpenBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 개행: 지정 없음(기본 따라감)은 흐리게 -->
        <Style x:Key="CellNewline" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="{StaticResource Font.Caption}"/>
            <Setter Property="Foreground" Value="{Binding NewlineBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource OnAccent}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="2,0,0,10" Style="{StaticResource HintText}"
                   Text="{loc:Str Sess.Intro}"/>

        <!-- 표 머리글 -->
        <Border Grid.Row="1" Background="Transparent" Padding="12,0,12,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="108"/>
                    <ColumnDefinition Width="132"/>
                    <ColumnDefinition Width="126"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:Str Common.Name}" Style="{StaticResource TableHeaderText}"/>
                <TextBlock Grid.Column="1" Text="{loc:Str Common.Port}" Style="{StaticResource TableHeaderText}"/>
                <TextBlock Grid.Column="2" Text="{loc:Str Common.Baud}" Style="{StaticResource TableHeaderText}"/>
                <TextBlock Grid.Column="3" Text="{loc:Str Sess.OnOpen}" Style="{StaticResource TableHeaderText}"/>
                <TextBlock Grid.Column="4" Text="{loc:Str Sess.NewlineCol}" Style="{StaticResource TableHeaderText}"/>
                <TextBlock Grid.Column="5" Text="{loc:Str Common.CommandGroup}" Style="{StaticResource TableHeaderText}"/>
            </Grid>
        </Border>

        <!-- 세션 목록 -->
        <Border Grid.Row="2" Style="{StaticResource InsetPanel}">
        <Grid>
        <ListBox x:Name="SessionList" SelectionChanged="SessionList_SelectionChanged"
                 Background="Transparent" BorderThickness="0" Padding="4"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <!-- 머리글 Grid 와 폭이 반드시 같아야 한다(다르면 열이 어긋나 글자가 겹친다) -->
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="108"/>
                            <ColumnDefinition Width="132"/>
                            <ColumnDefinition Width="126"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource Cell}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Port}" Style="{StaticResource CellPort}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Baud}" Style="{StaticResource CellBaud}"/>
                        <TextBlock Grid.Column="3" Text="{Binding OnOpenDisplay}" Style="{StaticResource CellOnOpen}"/>
                        <TextBlock Grid.Column="4" Text="{Binding NewlineDisplay}" Style="{StaticResource CellNewline}"/>
                        <TextBlock Grid.Column="5" Text="{Binding GroupDisplay}" Style="{StaticResource CellGroup}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock x:Name="SessionListEmpty" Style="{StaticResource EmptyStateText}"
                   Text="{loc:Str Sess.EmptyList}"/>
        </Grid>
        </Border>

        <!-- 선택 항목 편집 -->
        <Border Grid.Row="3" x:Name="EditPane" Margin="0,12,0,0" IsEnabled="False"
                Background="{DynamicResource Bg}" BorderBrush="{DynamicResource BorderBrush2}"
                BorderThickness="1" CornerRadius="8" Padding="16,12">
            <Grid>
                <!--
                  폼 규칙: 한 줄에 놓이는 컨트롤은 <b>높이가 같아야 한다</b>(32).
                  전에는 TextBox 가 Padding 때문에 40 가까이 되고 콤보는 30 이라 줄마다 높이가
                  달랐고, 버튼은 VerticalAlignment 기본값(Stretch)이라 행 높이만큼 세로로 늘어났다.
                  그래서 "비율이 엉망" 으로 보였다. 라벨도 입력과 왼쪽을 맞춘다(2px 밀면 어긋나 보인다).
                -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Str Common.Name}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{loc:Str Common.Port}" Style="{StaticResource FieldLabel}" Margin="12,0,0,4"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="{loc:Str Common.Baud}" Style="{StaticResource FieldLabel}" Margin="12,0,0,4"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="{loc:Str Common.CommandGroup}" Style="{StaticResource FieldLabel}" Margin="12,0,0,4"/>
                <TextBlock Grid.Row="0" Grid.Column="4" Text="{loc:Str Sess.OnOpen}" Style="{StaticResource FieldLabel}" Margin="12,0,0,4"/>

                <!-- MinWidth=0: 기본 스타일의 최소폭 때문에 * 열이 줄지 못해 오른쪽 [삭제] 가 잘리는 것을 막는다 -->
                <TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="0" Style="{StaticResource CommandInput}"
                         MaxLength="40" Height="32" MinWidth="0" Padding="9,0" VerticalContentAlignment="Center"
                         TextChanged="NameBox_TextChanged"/>
                <!--
                  IsEditable: 지금 안 꽂힌 포트도 적을 수 있어야 한다. 세션은 '다음에 어디로 붙을지' 를
                  적어 둔 값이라, 보드를 빼 둔 상태에서 미리 고쳐 두는 것이 정상 사용이다.
                  목록에는 지금 연결된 포트에 저장된 값을 얹어 준다(없어진 포트도 지워지지 않게).
                -->
                <ComboBox x:Name="PortBox" Grid.Row="1" Grid.Column="1" Width="118" Height="32" Margin="12,0,0,0"
                          Style="{StaticResource EditableCombo}" FontFamily="{StaticResource MonoFont}"
                          VerticalAlignment="Center" VerticalContentAlignment="Center"
                          ToolTip="{loc:Str Sess.PortTip}"
                          LostFocus="PortBox_Typed" SelectionChanged="PortBox_Picked"/>
                <ComboBox x:Name="BaudBox" Grid.Row="1" Grid.Column="2" Width="112" Height="32" Margin="12,0,0,0"
                          Style="{StaticResource EditableCombo}"
                          VerticalAlignment="Center" VerticalContentAlignment="Center"
                          ToolTip="{loc:Str Port.BaudTip}"
                          LostFocus="BaudBox_Typed" SelectionChanged="BaudBox_Picked"/>
                <ComboBox x:Name="GroupBox" Grid.Row="1" Grid.Column="3" Width="140" Height="32" Margin="12,0,0,0"
                          VerticalAlignment="Center" VerticalContentAlignment="Center" SelectionChanged="GroupBox_SelectionChanged"/>
                <!-- 접속 속성이라 여기서 편집 가능 — 세션이 진실의 출처다.
                     MCP 는 포트별로 노출을 켜는 것이라 전역 설정이 될 수 없어 여기(세션)에 함께 둔다. -->
                <StackPanel Grid.Row="1" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center"
                            Margin="12,0,0,0">
                    <CheckBox x:Name="ResetCheck" Style="{StaticResource AppCheckBox}"
                              Content="{loc:Str Sess.Reset}" VerticalAlignment="Center"
                              ToolTip="{loc:Str Sess.ResetTip}"
                              Click="ResetCheck_Click"/>
                    <CheckBox x:Name="McpCheck" Style="{StaticResource AppCheckBox}"
                              Content="{loc:Str Sess.Mcp}" VerticalAlignment="Center" Margin="14,0,0,0"
                              ToolTip="{loc:Str Sess.McpTip}"
                              Click="McpCheck_Click"/>
                </StackPanel>
                <Button x:Name="DeleteButton" Grid.Row="1" Grid.Column="5" Content="{loc:Str Common.Delete}"
                        Style="{StaticResource GhostButton}" MinWidth="64" Height="32" Padding="0"
                        VerticalAlignment="Center" Margin="12,0,0,0" Click="Delete_Click"/>

                <!-- 개행: 수신·송신은 대등한 한 쌍이라 나란히 둔다.
                     전에는 송신이 '속도' 열에 붙어 수신과 멀찍이 떨어졌고 폭이 좁아 글자가 잘렸다. -->
                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="6" Margin="0,14,0,0">
                    <TextBlock Text="{loc:Str Sess.NewlineGroup}" Style="{StaticResource FieldLabel}" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal">
                    <StackPanel>
                        <TextBlock Text="{loc:Str Sess.NewlineRx}" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="RxBox" Width="210" Height="32" VerticalContentAlignment="Center"
                                  ToolTip="{loc:Str Sess.RxTip}" SelectionChanged="RxBox_SelectionChanged"/>
                    </StackPanel>
                    <StackPanel Margin="12,0,0,0">
                        <TextBlock Text="{loc:Str Sess.NewlineTx}" Style="{StaticResource CaptionText}" Margin="0,0,0,4"/>
                        <ComboBox x:Name="TxBox" Width="210" Height="32" VerticalContentAlignment="Center"
                                  ToolTip="{loc:Str Sess.TxTip}" SelectionChanged="TxBox_SelectionChanged"/>
                    </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- 로그 폴더: 파일명이 아니라 '폴더' 다 — 이름은 열 때마다 규칙으로 새로 만든다 -->
                <TextBlock Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="6" Text="{loc:Str Sess.LogFolder}"
                           Style="{StaticResource FieldLabel}" Margin="0,14,0,4"/>
                <!-- 이 줄은 위쪽 열 폭에 끌려가면 안 된다 — [찾기] 버튼이 '열 때' 열만큼
                     넓어져 버렸다. 자체 3열로 독립시킨다. -->
                <Grid Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="LogFolderBox" Grid.Column="0"
                             Style="{StaticResource CommandInput}" Height="32" MinWidth="0"
                             Padding="9,0" VerticalContentAlignment="Center"
                             ToolTip="{loc:Str Sess.LogFolderTip}" TextChanged="LogFolderBox_TextChanged"/>
                    <Button x:Name="LogFolderBrowse" Grid.Column="1" Content="…"
                            Style="{StaticResource DialogButton}" MinWidth="44" Width="44" Height="32" Padding="0"
                            VerticalAlignment="Center" Margin="12,0,0,0" Click="LogFolderBrowse_Click"/>
                    <Button x:Name="LogFolderClear" Grid.Column="2" Content="{loc:Str Common.Clear}"
                            Style="{StaticResource GhostButton}" MinWidth="64" Height="32" Padding="0"
                            VerticalAlignment="Center" Margin="12,0,0,0" Click="LogFolderClear_Click"/>
                </Grid>
            </Grid>
        </Border>

        <!-- StackPanel 은 자식을 늘리지 않아 HorizontalAlignment=Right 가 먹지 않는다 → Grid 2열로 좌/우 분리 -->
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="PathText" Foreground="{DynamicResource TextFaint}" FontSize="{StaticResource Font.Caption}"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="380"/>
                <Button Content="{loc:Str Common.OpenFolder}" Style="{StaticResource DialogButton}" MinWidth="0" MinHeight="24"
                        Padding="10,0" Margin="10,0,0,0" Click="OpenFolder_Click"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="{loc:Str Common.Cancel}" Style="{StaticResource GhostButton}" MinHeight="30" IsCancel="True"/>
                <Button x:Name="OkButton" Content="{loc:Str Common.Save}" Style="{StaticResource SendButton}"
                        MinWidth="86" MinHeight="30" Margin="8,0,0,0" IsDefault="True" Click="Ok_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
