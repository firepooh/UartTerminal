<Window x:Class="UartTerminal.SessionManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="세션 관리 — UartTerminal"
        Icon="/UartTerminal.ico"
        Width="760" Height="470" MinWidth="640" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <!-- 표 셀 텍스트: 선택된 행(파란 배경)에서는 흰색으로 바꿔 대비를 유지한다.
             (열마다 색을 직접 지정하면 ListBoxItem 의 선택 시 Foreground 상속이 덮여 파란 글씨가 파란 배경에 묻는다) -->
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CellPort" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="Foreground" Value="{StaticResource Blue}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CellBaud" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CellGroup" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="Foreground" Value="{Binding GroupBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 열 때 리셋: 켜진 항목만 눈에 띄게(꺼짐은 흐린 "—") -->
        <Style x:Key="CellReset" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="Foreground" Value="{Binding ResetBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="2,0,0,10" FontSize="12.5" TextWrapping="Wrap"
                   Foreground="{StaticResource TextDim}"
                   Text="저장된 접속 프로필입니다. 이름·포트·속도·열 때 리셋과 연결된 명령 그룹을 한눈에 확인하고 편집할 수 있습니다. (접속은 [터미널 > 재연결] 또는 새 탭에서 세션을 더블클릭)"/>

        <!-- 표 머리글 -->
        <Border Grid.Row="1" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="1" CornerRadius="6,6,0,0" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="96"/>
                    <ColumnDefinition Width="86"/>
                    <ColumnDefinition Width="96"/>
                    <ColumnDefinition Width="136"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="이름" Foreground="{StaticResource TextMuted}" FontSize="11.5" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="포트" Foreground="{StaticResource TextMuted}" FontSize="11.5" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="2" Text="속도" Foreground="{StaticResource TextMuted}" FontSize="11.5" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="3" Text="열 때 리셋" Foreground="{StaticResource TextMuted}" FontSize="11.5" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="4" Text="명령 그룹" Foreground="{StaticResource TextMuted}" FontSize="11.5" FontWeight="SemiBold"/>
            </Grid>
        </Border>

        <!-- 세션 목록 -->
        <ListBox x:Name="SessionList" Grid.Row="2" SelectionChanged="SessionList_SelectionChanged"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="96"/>
                            <ColumnDefinition Width="86"/>
                            <ColumnDefinition Width="96"/>
                            <ColumnDefinition Width="136"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource Cell}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Port}" Style="{StaticResource CellPort}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Baud}" Style="{StaticResource CellBaud}"/>
                        <TextBlock Grid.Column="3" Text="{Binding ResetDisplay}" Style="{StaticResource CellReset}"/>
                        <TextBlock Grid.Column="4" Text="{Binding GroupDisplay}" Style="{StaticResource CellGroup}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 선택 항목 편집 -->
        <Border Grid.Row="3" x:Name="EditPane" Margin="0,12,0,0" IsEnabled="False"
                Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="1" CornerRadius="8" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="이름" Foreground="{StaticResource TextDim}" FontSize="11.5" Margin="2,0,0,4"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="속도" Foreground="{StaticResource TextDim}" FontSize="11.5" Margin="10,0,0,4"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="명령 그룹" Foreground="{StaticResource TextDim}" FontSize="11.5" Margin="10,0,0,4"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="열 때" Foreground="{StaticResource TextDim}" FontSize="11.5" Margin="10,0,0,4"/>

                <!-- MinWidth=0: 기본 스타일의 최소폭 때문에 * 열이 줄지 못해 오른쪽 [삭제] 가 잘리는 것을 막는다 -->
                <TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="0" Style="{StaticResource CommandInput}"
                         MaxLength="40" MinHeight="30" MinWidth="0" TextChanged="NameBox_TextChanged"/>
                <ComboBox x:Name="BaudBox" Grid.Row="1" Grid.Column="1" Width="104" Height="30" Margin="10,0,0,0"
                          VerticalContentAlignment="Center" SelectionChanged="BaudBox_SelectionChanged"/>
                <ComboBox x:Name="GroupBox" Grid.Row="1" Grid.Column="2" Width="136" Height="30" Margin="10,0,0,0"
                          VerticalContentAlignment="Center" SelectionChanged="GroupBox_SelectionChanged"/>
                <!-- 접속 속성이라 여기서 편집 가능(포트와 달리 세션이 진실의 출처) -->
                <CheckBox x:Name="ResetCheck" Grid.Row="1" Grid.Column="3" Style="{StaticResource DarkCheckBox}"
                          Content="리셋" VerticalAlignment="Center" Margin="12,0,0,0"
                          ToolTip="이 세션으로 접속할 때 EN 펄스로 보드를 리셋(부팅 로그를 처음부터)"
                          Click="ResetCheck_Click"/>
                <Button x:Name="DeleteButton" Grid.Row="1" Grid.Column="4" Content="삭제"
                        Style="{StaticResource DialogButton}" MinWidth="64" MinHeight="30" Padding="0"
                        Margin="10,0,0,0" Click="Delete_Click"/>
            </Grid>
        </Border>

        <!-- StackPanel 은 자식을 늘리지 않아 HorizontalAlignment=Right 가 먹지 않는다 → Grid 2열로 좌/우 분리 -->
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="PathText" Foreground="{StaticResource TextFaint}" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="380"/>
                <Button Content="폴더 열기" Style="{StaticResource DialogButton}" MinWidth="0" MinHeight="24"
                        Padding="10,0" Margin="10,0,0,0" Click="OpenFolder_Click"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="OkButton" Content="저장" Style="{StaticResource SendButton}"
                        MinWidth="86" MinHeight="30" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
                <Button Content="취소" Style="{StaticResource DialogButton}" MinHeight="30" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
