<Window x:Class="UartTerminal.SessionManagerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:UartTerminal"
        Title="{loc:Str Sess.Title}"
        Icon="/UartTerminal.ico"
        Width="880" Height="500" MinWidth="720" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}">
    <Window.Resources>
        <!-- 표 셀 텍스트: 선택된 행(파란 배경)에서는 흰색으로 바꿔 대비를 유지한다.
             (열마다 색을 직접 지정하면 ListBoxItem 의 선택 시 Foreground 상속이 덮여 파란 글씨가 파란 배경에 묻는다) -->
        <Style x:Key="Cell" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CellPort" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="Foreground" Value="{StaticResource Blue}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CellBaud" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="Foreground" Value="{StaticResource TextDim}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CellGroup" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="Foreground" Value="{Binding GroupBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 열 때 리셋: 켜진 항목만 눈에 띄게(꺼짐은 흐린 "—") -->
        <Style x:Key="CellReset" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="Foreground" Value="{Binding ResetBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
        <!-- 개행: 지정 없음(기본 따라감)은 흐리게 -->
        <Style x:Key="CellNewline" TargetType="TextBlock" BasedOn="{StaticResource Cell}">
            <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="Foreground" Value="{Binding NewlineBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Margin="2,0,0,10" FontSize="12.5" TextWrapping="Wrap"
                   Foreground="{StaticResource TextDim}"
                   Text="{loc:Str Sess.Intro}"/>

        <!-- 표 머리글 -->
        <Border Grid.Row="1" Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="1" CornerRadius="6,6,0,0" Padding="10,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="90"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="88"/>
                    <ColumnDefinition Width="132"/>
                    <ColumnDefinition Width="126"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="{loc:Str Common.Name}" Foreground="{StaticResource TextMuted}" FontSize="11.5" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="1" Text="{loc:Str Common.Port}" Foreground="{StaticResource TextMuted}" FontSize="11.5" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="2" Text="{loc:Str Common.Baud}" Foreground="{StaticResource TextMuted}" FontSize="11.5" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="3" Text="{loc:Str Sess.ResetCol}" Foreground="{StaticResource TextMuted}" FontSize="11.5" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="4" Text="{loc:Str Sess.NewlineCol}" Foreground="{StaticResource TextMuted}" FontSize="11.5" FontWeight="SemiBold"/>
                <TextBlock Grid.Column="5" Text="{loc:Str Common.CommandGroup}" Foreground="{StaticResource TextMuted}" FontSize="11.5" FontWeight="SemiBold"/>
            </Grid>
        </Border>

        <!-- 세션 목록 -->
        <ListBox x:Name="SessionList" Grid.Row="2" SelectionChanged="SessionList_SelectionChanged"
                 HorizontalContentAlignment="Stretch">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <!-- 머리글 Grid 와 폭이 반드시 같아야 한다(다르면 열이 어긋나 글자가 겹친다) -->
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="88"/>
                            <ColumnDefinition Width="132"/>
                            <ColumnDefinition Width="126"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding Name}" Style="{StaticResource Cell}"/>
                        <TextBlock Grid.Column="1" Text="{Binding Port}" Style="{StaticResource CellPort}"/>
                        <TextBlock Grid.Column="2" Text="{Binding Baud}" Style="{StaticResource CellBaud}"/>
                        <TextBlock Grid.Column="3" Text="{Binding ResetDisplay}" Style="{StaticResource CellReset}"/>
                        <TextBlock Grid.Column="4" Text="{Binding NewlineDisplay}" Style="{StaticResource CellNewline}"/>
                        <TextBlock Grid.Column="5" Text="{Binding GroupDisplay}" Style="{StaticResource CellGroup}"/>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 선택 항목 편집 -->
        <Border Grid.Row="3" x:Name="EditPane" Margin="0,12,0,0" IsEnabled="False"
                Background="{StaticResource BgPanel}" BorderBrush="{StaticResource BorderBrush2}"
                BorderThickness="1" CornerRadius="8" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Str Common.Name}" Foreground="{StaticResource TextDim}" FontSize="11.5" Margin="2,0,0,4"/>
                <TextBlock Grid.Row="0" Grid.Column="1" Text="{loc:Str Common.Baud}" Foreground="{StaticResource TextDim}" FontSize="11.5" Margin="10,0,0,4"/>
                <TextBlock Grid.Row="0" Grid.Column="2" Text="{loc:Str Common.CommandGroup}" Foreground="{StaticResource TextDim}" FontSize="11.5" Margin="10,0,0,4"/>
                <TextBlock Grid.Row="0" Grid.Column="3" Text="{loc:Str Sess.OnOpen}" Foreground="{StaticResource TextDim}" FontSize="11.5" Margin="10,0,0,4"/>

                <!-- MinWidth=0: 기본 스타일의 최소폭 때문에 * 열이 줄지 못해 오른쪽 [삭제] 가 잘리는 것을 막는다 -->
                <TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="0" Style="{StaticResource CommandInput}"
                         MaxLength="40" MinHeight="30" MinWidth="0" TextChanged="NameBox_TextChanged"/>
                <ComboBox x:Name="BaudBox" Grid.Row="1" Grid.Column="1" Width="104" Height="30" Margin="10,0,0,0"
                          VerticalContentAlignment="Center" SelectionChanged="BaudBox_SelectionChanged"/>
                <ComboBox x:Name="GroupBox" Grid.Row="1" Grid.Column="2" Width="136" Height="30" Margin="10,0,0,0"
                          VerticalContentAlignment="Center" SelectionChanged="GroupBox_SelectionChanged"/>
                <!-- 접속 속성이라 여기서 편집 가능(포트와 달리 세션이 진실의 출처) -->
                <CheckBox x:Name="ResetCheck" Grid.Row="1" Grid.Column="3" Style="{StaticResource DarkCheckBox}"
                          Content="{loc:Str Sess.Reset}" VerticalAlignment="Center" Margin="12,0,0,0"
                          ToolTip="{loc:Str Sess.ResetTip}"
                          Click="ResetCheck_Click"/>
                <Button x:Name="DeleteButton" Grid.Row="1" Grid.Column="4" Content="{loc:Str Common.Delete}"
                        Style="{StaticResource DialogButton}" MinWidth="64" MinHeight="30" Padding="0"
                        Margin="10,0,0,0" Click="Delete_Click"/>

                <!-- 개행은 값이 길어 둘째 줄에 둔다. "(기본)"=지정 없음 → 접속 시 현재 값을 그대로 쓴다 -->
                <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Str Sess.NewlineRx}" Foreground="{StaticResource TextDim}"
                           FontSize="11.5" Margin="2,12,0,4"/>
                <TextBlock Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" Text="{loc:Str Sess.NewlineTx}"
                           Foreground="{StaticResource TextDim}" FontSize="11.5" Margin="10,12,0,4"/>
                <ComboBox x:Name="RxBox" Grid.Row="3" Grid.Column="0" Height="30" HorizontalAlignment="Left"
                          Width="210" VerticalContentAlignment="Center" Margin="2,0,0,0"
                          ToolTip="{loc:Str Sess.RxTip}"
                          SelectionChanged="RxBox_SelectionChanged"/>
                <ComboBox x:Name="TxBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="2" Height="30"
                          HorizontalAlignment="Left" Width="136" VerticalContentAlignment="Center" Margin="10,0,0,0"
                          ToolTip="{loc:Str Sess.TxTip}"
                          SelectionChanged="TxBox_SelectionChanged"/>
            </Grid>
        </Border>

        <!-- StackPanel 은 자식을 늘리지 않아 HorizontalAlignment=Right 가 먹지 않는다 → Grid 2열로 좌/우 분리 -->
        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock x:Name="PathText" Foreground="{StaticResource TextFaint}" FontSize="11"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" MaxWidth="380"/>
                <Button Content="{loc:Str Common.OpenFolder}" Style="{StaticResource DialogButton}" MinWidth="0" MinHeight="24"
                        Padding="10,0" Margin="10,0,0,0" Click="OpenFolder_Click"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="OkButton" Content="{loc:Str Common.Save}" Style="{StaticResource SendButton}"
                        MinWidth="86" MinHeight="30" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
                <Button Content="{loc:Str Common.Cancel}" Style="{StaticResource DialogButton}" MinHeight="30" IsCancel="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
