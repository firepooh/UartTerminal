<Window x:Class="UartTerminal.PortSelectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:UartTerminal"
        Title="{loc:Str Port.Title}"
        Icon="/UartTerminal.ico"
        Width="520" Height="560" MinWidth="440" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource UiFont}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 저장된 세션(있을 때만 보인다 — 세션을 안 쓰는 사용자에겐 기존 화면 그대로) -->
        <Grid x:Name="SessionSection" Grid.Row="0" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="2,0,0,6">
                <Button x:Name="DeleteSessionButton" DockPanel.Dock="Right" Content="{loc:Str Common.Delete}"
                        Style="{StaticResource DialogButton}" MinWidth="0" MinHeight="24" Padding="10,0"
                        IsEnabled="False" Click="DeleteSession_Click"/>
                <TextBlock Text="{loc:Str Port.Sessions}" FontSize="13"
                           VerticalAlignment="Center" Foreground="{DynamicResource Text}"/>
            </DockPanel>
            <ListBox x:Name="SessionList" Grid.Row="1" Height="126"
                     SelectionChanged="SessionList_SelectionChanged"
                     MouseDoubleClick="SessionList_MouseDoubleClick"
                     DisplayMemberPath="Display"/>
        </Grid>

        <TextBlock Grid.Row="1" Margin="2,0,0,6" FontSize="13"
                   Foreground="{DynamicResource Text}"
                   Text="{loc:Str Port.Detected}"/>

        <TextBlock Grid.Row="2" Margin="2,0,0,6" FontSize="11"
                   Foreground="{DynamicResource TextFaint}"
                   Text="{loc:Str Port.Hint}"/>

        <ListBox x:Name="PortList" Grid.Row="3"
                 SelectionChanged="PortList_SelectionChanged"
                 MouseDoubleClick="PortList_MouseDoubleClick"
                 DisplayMemberPath="Display"/>

        <!-- 통신 속도(README §2): ESP-IDF 기본 115200 외에 부트로더 진단(74880)·고속 로그(921600)가 실수요 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="2,12,0,0" VerticalAlignment="Center">
            <TextBlock Text="{loc:Str Common.Baud}" VerticalAlignment="Center" Margin="0,0,10,0"
                       Foreground="{DynamicResource TextDim}" FontSize="12"/>
            <Border Style="{StaticResource SplitToolbar}">
                <StackPanel x:Name="BaudHost" Orientation="Horizontal"/>
            </Border>
            <TextBlock Text="bps" VerticalAlignment="Center" Margin="10,0,0,0"
                       Foreground="{DynamicResource TextFaint}" FontSize="11.5"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Margin="2,10,0,12">
            <!-- ESP32 devkit: DTR→IO0 / RTS→EN 자동 리셋 회로. 기본은 두 선 모두 해제해 보드를 건드리지 않는다. -->
            <CheckBox x:Name="ResetOnOpenCheck" Style="{StaticResource DarkCheckBox}"
                      Content="{loc:Str Port.ResetOnOpen}"
                      Margin="0,0,0,8"/>
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFaint}" FontSize="11.5"
                       Text="{loc:Str Port.Fixed}"/>
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="RefreshButton" Content="{loc:Str Common.Refresh}" Style="{StaticResource DialogButton}"
                    Margin="0,0,8,0" Click="Refresh_Click"/>
            <Button x:Name="OkButton" Content="{loc:Str Common.Connect}" Style="{StaticResource SendButton}"
                    MinWidth="86" MinHeight="30" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
            <Button Content="{loc:Str Common.Cancel}" Style="{StaticResource DialogButton}" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
