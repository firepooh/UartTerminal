<Window x:Class="UartTerminal.PortSelectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="연결 — UartTerminal"
        Icon="/UartTerminal.ico"
        Width="520" Height="560" MinWidth="440" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Background="{StaticResource Bg}"
        Foreground="{StaticResource Text}"
        FontFamily="{StaticResource UiFont}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 저장된 세션(있을 때만 보인다 — 세션을 안 쓰는 사용자에겐 기존 화면 그대로) -->
        <Grid x:Name="SessionSection" Grid.Row="0" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="2,0,0,6">
                <Button x:Name="DeleteSessionButton" DockPanel.Dock="Right" Content="삭제"
                        Style="{StaticResource DialogButton}" MinWidth="0" MinHeight="24" Padding="10,0"
                        IsEnabled="False" Click="DeleteSession_Click"/>
                <TextBlock Text="저장된 세션 (더블클릭하면 연결)" FontSize="13"
                           VerticalAlignment="Center" Foreground="{StaticResource Text}"/>
            </DockPanel>
            <ListBox x:Name="SessionList" Grid.Row="1" Height="126"
                     SelectionChanged="SessionList_SelectionChanged"
                     MouseDoubleClick="SessionList_MouseDoubleClick"
                     DisplayMemberPath="Display"/>
        </Grid>

        <TextBlock Grid.Row="1" Margin="2,0,0,6" FontSize="13"
                   Foreground="{StaticResource Text}"
                   Text="감지된 포트"/>

        <TextBlock Grid.Row="2" Margin="2,0,0,6" FontSize="11"
                   Foreground="{StaticResource TextFaint}"
                   Text="세션 없이 포트만 골라 바로 연결해도 됩니다."/>

        <ListBox x:Name="PortList" Grid.Row="3"
                 SelectionChanged="PortList_SelectionChanged"
                 MouseDoubleClick="PortList_MouseDoubleClick"
                 DisplayMemberPath="Display"/>

        <!-- 통신 속도(README §2): ESP-IDF 기본 115200 외에 부트로더 진단(74880)·고속 로그(921600)가 실수요 -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="2,12,0,0" VerticalAlignment="Center">
            <TextBlock Text="속도" VerticalAlignment="Center" Margin="0,0,10,0"
                       Foreground="{StaticResource TextDim}" FontSize="12"/>
            <Border Style="{StaticResource SplitToolbar}">
                <StackPanel x:Name="BaudHost" Orientation="Horizontal"/>
            </Border>
            <TextBlock Text="bps" VerticalAlignment="Center" Margin="10,0,0,0"
                       Foreground="{StaticResource TextFaint}" FontSize="11.5"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Margin="2,10,0,12">
            <!-- ESP32 devkit: DTR→IO0 / RTS→EN 자동 리셋 회로. 기본은 두 선 모두 해제해 보드를 건드리지 않는다. -->
            <CheckBox x:Name="ResetOnOpenCheck" Style="{StaticResource DarkCheckBox}"
                      Content="열 때 보드 리셋 (EN 펄스 — 부팅 로그를 처음부터 보기)"
                      Margin="0,0,0,8" Click="ResetOnOpen_Click"/>
            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource TextFaint}" FontSize="11.5"
                       Text="나머지는 고정: 8비트 · 패리티 없음 · 스톱 1 · 흐름제어 없음 · 오픈 시 DTR/RTS 해제"/>
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="RefreshButton" Content="새로고침" Style="{StaticResource DialogButton}"
                    Margin="0,0,8,0" Click="Refresh_Click"/>
            <Button x:Name="OkButton" Content="연결" Style="{StaticResource SendButton}"
                    MinWidth="86" MinHeight="30" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
            <Button Content="취소" Style="{StaticResource DialogButton}" IsCancel="True"/>
        </StackPanel>
    </Grid>
</Window>
