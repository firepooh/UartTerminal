<Window x:Class="UartTerminal.PortSelectDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:UartTerminal"
        Title="{loc:Str Port.Title}"
        Icon="/UartTerminal.ico"
        Width="520" Height="560" MinWidth="440" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResize"
        ShowInTaskbar="True"
        Background="{DynamicResource BgPanel}"
        Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource UiFont}">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 저장된 세션(있을 때만 보인다 — 세션을 안 쓰는 사용자에겐 기존 화면 그대로) -->
        <Grid x:Name="SessionSection" Grid.Row="0" Margin="0,0,0,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <DockPanel Grid.Row="0" Margin="0,0,0,6">
                <Button x:Name="DeleteSessionButton" DockPanel.Dock="Right" Content="{loc:Str Common.Delete}"
                        Style="{StaticResource DialogButton}" MinWidth="0" MinHeight="24" Padding="10,0"
                        IsEnabled="False" Click="DeleteSession_Click"/>
                <TextBlock Text="{loc:Str Port.Sessions}" FontSize="{StaticResource Font.Emph}"
                           VerticalAlignment="Center" Foreground="{DynamicResource Text}"/>
            </DockPanel>
            <ListBox x:Name="SessionList" Grid.Row="1" Height="126"
                     SelectionChanged="SessionList_SelectionChanged"
                     MouseDoubleClick="SessionList_MouseDoubleClick"
                     DisplayMemberPath="Display"/>
        </Grid>

        <TextBlock Grid.Row="1" Margin="0,0,0,6" FontSize="{StaticResource Font.Emph}"
                   Foreground="{DynamicResource Text}"
                   Text="{loc:Str Port.Detected}"/>

        <TextBlock Grid.Row="2" Margin="0,0,0,6" FontSize="{StaticResource Font.Caption}"
                   Foreground="{DynamicResource TextFaint}"
                   Text="{loc:Str Port.Hint}"/>

        <Border Grid.Row="3" Style="{StaticResource InsetPanel}">
            <Grid>
                <ListBox x:Name="PortList" Background="Transparent" BorderThickness="0" Padding="4"
                         SelectionChanged="PortList_SelectionChanged"
                         MouseDoubleClick="PortList_MouseDoubleClick"
                         DisplayMemberPath="Display"/>
                <TextBlock x:Name="PortListEmpty" Style="{StaticResource EmptyStateText}"
                           Text="{loc:Str Port.EmptyList}"/>
            </Grid>
        </Border>

<!--
          속도: 예전에는 칩 5개(74880·115200·230400·460800·921600)였다. ESP-IDF 실수요만 담은 것이었는데,
          9600 같은 장비를 붙일 방법이 아예 없었다. 표준 목록을 다 담으려니 칩으로는 너무 길어져
          직접 입력 되는 콤보로 바꿨다 — 목록에 없는 속도도 칠 수 있다.
        -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" Margin="0,12,0,0" VerticalAlignment="Center">
            <TextBlock Text="{loc:Str Common.Baud}" VerticalAlignment="Center" Margin="0,0,10,0"
                       Style="{StaticResource FieldLabel}"/>
            <ComboBox x:Name="BaudBox" Width="118" Height="32"
                      Style="{StaticResource EditableCombo}"
                      VerticalAlignment="Center" VerticalContentAlignment="Center"
                      ToolTip="{loc:Str Port.BaudTip}"
                      LostFocus="BaudBox_Typed" SelectionChanged="BaudBox_Picked"/>
            <TextBlock Text="bps" VerticalAlignment="Center" Margin="10,0,0,0"
                       Foreground="{DynamicResource TextFaint}" FontSize="{StaticResource Font.Caption}"/>
        </StackPanel>

        <StackPanel Grid.Row="5" Margin="0,12,0,12">
            <!-- ESP32 devkit: DTR→IO0 / RTS→EN 자동 리셋 회로. 기본은 두 선 모두 해제해 보드를 건드리지 않는다. -->
            <CheckBox x:Name="ResetOnOpenCheck" Style="{StaticResource AppCheckBox}"
                      Content="{loc:Str Port.ResetOnOpen}"
                      Margin="0,0,0,8"/>
            <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource TextFaint}" FontSize="{StaticResource Font.Caption}"
                       Text="{loc:Str Port.Fixed}"/>
        </StackPanel>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="RefreshButton" Content="{loc:Str Common.Refresh}" Style="{StaticResource DialogButton}"
                    Margin="0,0,8,0" Click="Refresh_Click"/>
            <Button Content="{loc:Str Common.Cancel}" Style="{StaticResource GhostButton}" IsCancel="True"/>
            <Button x:Name="OkButton" Content="{loc:Str Common.Connect}" Style="{StaticResource SendButton}"
                    MinWidth="86" MinHeight="30" Margin="8,0,0,0" IsDefault="True" Click="Ok_Click"/>
        </StackPanel>
    </Grid>
</Window>
