<UserControl x:Class="UartTerminal.UartDocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{StaticResource Bg}">
    <DockPanel>
        <!-- 하단 입력 전용 행: 터미널 출력이 쏟아질 때 안정적으로 명령 입력.
             클릭해서 포커스를 주면 여기로 입력, Enter 또는 Send 로 전송. 기본 포커스는 메인 터미널(type-through). -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="Prompt" Grid.Column="0" Text="&gt;"
                           Foreground="{StaticResource Green}"
                           FontFamily="{StaticResource MonoFont}" FontSize="13" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="2,0,10,0"/>

                <TextBox x:Name="InputBox" Grid.Column="1"
                         Style="{StaticResource CommandInput}"
                         AcceptsReturn="False"
                         GotKeyboardFocus="InputBox_GotFocus"
                         LostKeyboardFocus="InputBox_LostFocus"
                         PreviewKeyDown="InputBox_PreviewKeyDown"/>

                <Button x:Name="SendButton" Grid.Column="2" Style="{StaticResource SendButton}"
                        Content="Send" Margin="10,0,0,0" MinHeight="38" Click="Send_Click"/>
            </Grid>
        </Border>

        <!-- 저장 명령 칩 바(Alt+B). 입력바보다 뒤에 선언 → DockPanel 도킹 순서상 입력바 '위'에 쌓인다.
             칩은 Focusable=False 여야 클릭 직후 타이핑이 그대로 터미널(type-through)로 나간다. -->
        <Border x:Name="CommandBar" DockPanel.Dock="Bottom" Visibility="Collapsed"
                Background="{StaticResource BgPanel}"
                BorderBrush="{StaticResource BorderBrush2}" BorderThickness="0,1,0,0"
                Padding="12,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <!-- 명령 그룹(프로젝트) 선택. 탭별로 독립이며, 세션 접속 시 자동 선택된다. -->
                    <!-- "CMD" 라벨 + 그룹명: 지금 어떤 명령 세트가 적용됐는지 항상 읽히게 한다. -->
                    <TextBlock x:Name="GroupLabel" Text="CMD" Visibility="Collapsed"
                               Foreground="{StaticResource TextFaint}" FontSize="10.5" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="GroupSelector" MinWidth="104" MaxWidth="160" Height="26"
                              Margin="0,0,8,0" VerticalContentAlignment="Center"
                              ToolTip="명령 그룹(프로젝트) 선택"
                              SelectionChanged="GroupSelector_SelectionChanged"/>
                    <!-- 그룹 구분선: 그룹 셀렉터와 칩 묶음을 시각적으로 분리 -->
                    <Rectangle x:Name="GroupDivider" Width="1" Height="16" Margin="0,0,8,0"
                               Fill="{StaticResource BorderStrong}" VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                    <ScrollViewer Focusable="False" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ChipHost" Orientation="Horizontal"/>
                    </ScrollViewer>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                    <Button x:Name="SaveCmdButton" Content="+ 저장" Style="{StaticResource DialogButton}"
                            MinWidth="0" MinHeight="26" Padding="10,0" Focusable="False"
                            ToolTip="현재 입력창 내용을 명령으로 저장" Click="SaveCommand_Click"/>
                    <Button x:Name="EditCmdButton" Content="편집" Style="{StaticResource DialogButton}"
                            MinWidth="0" MinHeight="26" Padding="10,0" Margin="6,0,0,0" Focusable="False"
                            ToolTip="저장 명령 편집" Click="EditCommands_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="ViewHost" Grid.Column="0" Background="{StaticResource Bg}"/>

            <!-- 스크롤백 검색 바(Ctrl+F). 우상단, 매치 하이라이트 + 이전/다음 이동. Esc 로 닫기. -->
            <Border x:Name="FindBar" Grid.Column="0" Visibility="Collapsed"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,8,14,0" Padding="8,6"
                    Background="#F20B0F16" BorderBrush="{StaticResource BorderStrong}"
                    BorderThickness="1" CornerRadius="8">
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="FindBox" Width="220" MinHeight="26" FontSize="12"
                             Style="{StaticResource CommandInput}" Padding="8,3"
                             TextChanged="FindBox_TextChanged" PreviewKeyDown="FindBox_PreviewKeyDown"/>
                    <TextBlock x:Name="FindCount" VerticalAlignment="Center" Margin="9,0,7,0"
                               MinWidth="46" Foreground="{StaticResource TextMuted}" FontSize="11.5"
                               FontFamily="{StaticResource MonoFont}" Text=""/>
                    <Button Content="▲" Style="{StaticResource DialogButton}" MinWidth="0" MinHeight="26"
                            Padding="9,0" Focusable="False" Click="FindPrev_Click" ToolTip="이전 (Shift+Enter)"/>
                    <Button Content="▼" Style="{StaticResource DialogButton}" MinWidth="0" MinHeight="26"
                            Padding="9,0" Margin="5,0,0,0" Focusable="False" Click="FindNext_Click" ToolTip="다음 (Enter)"/>
                    <Button Content="✕" Style="{StaticResource DialogButton}" MinWidth="0" MinHeight="26"
                            Padding="9,0" Margin="5,0,0,0" Focusable="False" Click="FindClose_Click" ToolTip="닫기 (Esc)"/>
                </StackPanel>
            </Border>

            <!-- 폰트 크기 실시간 표시(Ctrl+휠/Ctrl+±). 잠깐 떴다 사라짐. 마우스 입력 통과. -->
            <Border x:Name="ZoomIndicator" Grid.Column="0" Visibility="Collapsed"
                    IsHitTestVisible="False"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,10,12,0" Padding="11,6"
                    Background="#E60B0F16" BorderBrush="{StaticResource BorderStrong}"
                    BorderThickness="1" CornerRadius="7">
                <TextBlock x:Name="ZoomText" Foreground="{StaticResource Text}"
                           FontFamily="{StaticResource MonoFont}" FontSize="13" FontWeight="Bold"/>
            </Border>

            <ScrollBar x:Name="VScroll" Grid.Column="1" Orientation="Vertical"
                       Minimum="0" Maximum="0" SmallChange="1" Scroll="VScroll_Scroll"/>
        </Grid>
    </DockPanel>
</UserControl>
