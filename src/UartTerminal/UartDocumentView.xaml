<UserControl x:Class="UartTerminal.UartDocumentView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:UartTerminal"
             Background="{DynamicResource Bg}">
    <DockPanel>
        <!-- 하단 입력 전용 행: 터미널 출력이 쏟아질 때 안정적으로 명령 입력.
             클릭해서 포커스를 주면 여기로 입력, Enter 또는 Send 로 전송. 기본 포커스는 메인 터미널(type-through). -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource BgPanel}"
                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,1,0,0"
                Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="Prompt" Grid.Column="0" Text="&gt;"
                           Foreground="{DynamicResource Green}"
                           FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource Font.Emph}" FontWeight="Bold"
                           VerticalAlignment="Center" Margin="2,0,10,0"/>

                <TextBox x:Name="InputBox" Grid.Column="1"
                         Style="{StaticResource CommandInput}"
                         AcceptsReturn="False"
                         GotKeyboardFocus="InputBox_GotFocus"
                         LostKeyboardFocus="InputBox_LostFocus"
                         PreviewKeyDown="InputBox_PreviewKeyDown"/>

                <Button x:Name="SendButton" Grid.Column="2" Style="{StaticResource SendButton}"
                        Content="Send" Margin="10,0,0,0" MinHeight="38" Click="Send_Click"/>
            </Grid>
        </Border>

        <!-- 저장 명령 칩 바(Alt+B). 입력바보다 뒤에 선언 → DockPanel 도킹 순서상 입력바 '위'에 쌓인다.
             칩은 Focusable=False 여야 클릭 직후 타이핑이 그대로 터미널(type-through)로 나간다. -->
        <Border x:Name="CommandBar" DockPanel.Dock="Bottom" Visibility="Collapsed"
                Background="{DynamicResource BgPanel}"
                BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,1,0,0"
                Padding="12,7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <!-- 명령 그룹(프로젝트) 선택. 탭별로 독립이며, 세션 접속 시 자동 선택된다. -->
                    <!-- "CMD" 라벨 + 그룹명: 지금 어떤 명령 세트가 적용됐는지 항상 읽히게 한다. -->
                    <TextBlock x:Name="GroupLabel" Text="CMD" Visibility="Collapsed"
                               Foreground="{DynamicResource TextFaint}" FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold"
                               VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <ComboBox x:Name="GroupSelector" MinWidth="104" MaxWidth="160" Height="26"
                              Margin="0,0,8,0" VerticalContentAlignment="Center"
                              ToolTip="{loc:Str Doc.GroupTip}"
                              SelectionChanged="GroupSelector_SelectionChanged"/>
                    <!-- 그룹 구분선: 그룹 셀렉터와 칩 묶음을 시각적으로 분리 -->
                    <Rectangle x:Name="GroupDivider" Width="1" Height="16" Margin="0,0,8,0"
                               Fill="{DynamicResource BorderStrong}" VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                    <ScrollViewer Focusable="False" HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ChipHost" Orientation="Horizontal"/>
                    </ScrollViewer>
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                    <Button x:Name="SaveCmdButton" Content="{loc:Str Doc.SaveChip}" Style="{StaticResource DialogButton}"
                            MinWidth="0" MinHeight="26" Padding="10,0" Focusable="False"
                            ToolTip="{loc:Str Doc.SaveChipTip}" Click="SaveCommand_Click"/>
                    <Button x:Name="EditCmdButton" Content="{loc:Str Common.Edit}" Style="{StaticResource DialogButton}"
                            MinWidth="0" MinHeight="26" Padding="10,0" Margin="6,0,0,0" Focusable="False"
                            ToolTip="{loc:Str Doc.EditChipTip}" Click="EditCommands_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid>
            <Grid.ColumnDefinitions>
                <!-- 터미널(+스크롤바) | 스플리터 | 파싱 패널.
                     스플리터의 PreviousAndNext 가 '터미널 열 ↔ 패널 열' 을 조절해야 하므로
                     스크롤바는 터미널과 함께 안쪽 Grid 로 묶는다(사이에 끼면 스플리터가 스크롤바 열을 늘린다). -->
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <!-- 파싱 패널 열: 숨김일 때 0, 표시할 때 코드가 저장된 폭을 되살린다(스플리터가 이 폭을 조절) -->
                <ColumnDefinition x:Name="ParseCol" Width="0"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border x:Name="ViewHost" Grid.Column="0" Background="{DynamicResource Bg}"/>
                <ScrollBar x:Name="VScroll" Grid.Column="1" Orientation="Vertical"
                           Minimum="0" Maximum="0" SmallChange="1" Scroll="VScroll_Scroll"/>
            </Grid>

            <!-- 파싱 패널 폭 조절 스플리터(패널과 함께 나타난다) -->
            <GridSplitter x:Name="ParseSplitter" Grid.Column="1" Width="5" Visibility="Collapsed"
                          HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                          Background="Transparent" ResizeBehavior="PreviousAndNext"
                          ResizeDirection="Columns" Focusable="False"/>

            <!-- 메시지 파싱 패널: 장비→서버 보고 라인(T블록)을 필드 정의(parsers.json)로 해석해 보여준다.
                 기본은 최신 메시지 따라가기, 터미널에서 텍스트를 선택하면 그 메시지로 고정된다. -->
            <Border x:Name="ParsePanel" Grid.Column="2" Visibility="Collapsed"
                    Background="{DynamicResource BgPanel}"
                    BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="1,0,0,0">
                <DockPanel>
                    <Border DockPanel.Dock="Top" Padding="12,7"
                            BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <!-- 제목 툴팁 = 현재 정의 파일 전체 경로(코드가 채운다) -->
                            <TextBlock x:Name="ParseTitle" Grid.Column="0" Text="{loc:Str Parse.Title}"
                                       Style="{StaticResource TableHeaderText}" VerticalAlignment="Center"/>
                            <!-- 선택으로 고정됐을 때만 나타난다 — 누르면 다시 최신 메시지를 따라간다 -->
                            <Button x:Name="ParseFollowButton" Grid.Column="1" Visibility="Collapsed"
                                    Content="{loc:Str Parse.FollowLatest}" Style="{StaticResource DialogButton}"
                                    MinWidth="0" MinHeight="22" Padding="8,0" Focusable="False"
                                    Click="ParseFollow_Click"/>
                            <Button Grid.Column="2" Content="{loc:Str Common.Clear}" Style="{StaticResource DialogButton}"
                                    MinWidth="0" MinHeight="22" Padding="8,0" Margin="6,0,0,0" Focusable="False"
                                    ToolTip="{loc:Str Parse.ClearTip}" Click="ParseClear_Click"/>
                            <Button Grid.Column="3" Content="{loc:Str Parse.PickFile}" Style="{StaticResource DialogButton}"
                                    MinWidth="0" MinHeight="22" Padding="8,0" Margin="6,0,0,0" Focusable="False"
                                    ToolTip="{loc:Str Parse.PickFileTip}" Click="ParsePickFile_Click"/>
                            <Button Grid.Column="4" Content="✕" Style="{StaticResource DialogButton}"
                                    MinWidth="0" MinHeight="22" Padding="7,0" Margin="6,0,0,0" Focusable="False"
                                    Click="ParseClose_Click"/>
                        </Grid>
                    </Border>
                    <!-- 메시지 키 필터: 정의 파일의 키마다 체크박스 — 보고 싶은 것만 남긴다.
                         ItemWidth 로 열이 맞춰지고(키 길이가 달라도 격자 정렬), 오른쪽에 전체/해제. -->
                    <Border DockPanel.Dock="Top" Padding="12,6"
                            BorderBrush="{DynamicResource BorderBrush2}" BorderThickness="0,0,0,1">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <WrapPanel x:Name="ParseKeyFilter" Grid.Column="0" ItemWidth="62"/>
                            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Top">
                                <Button Content="{loc:Str Parse.SelectAll}" Style="{StaticResource DialogButton}"
                                        MinWidth="0" MinHeight="22" Padding="8,0" Focusable="False"
                                        Click="ParseSelectAll_Click"/>
                                <Button Content="{loc:Str Parse.SelectNone}" Style="{StaticResource DialogButton}"
                                        MinWidth="0" MinHeight="22" Padding="8,0" Margin="0,5,0,0" Focusable="False"
                                        Click="ParseSelectNone_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                        <!-- 섹션은 '카드' 로 흐른다: 작은 메시지(T12류)는 한 줄에 나란히, 큰 메시지(T5류)는
                             내부에서 다단으로 펼쳐진다. 열 수는 패널 폭이 정하므로(SizeChanged) 설정이 없다. -->
                        <WrapPanel x:Name="ParseHost" Margin="12,8,12,12" SizeChanged="ParseHost_SizeChanged"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <!-- 스크롤백 검색 바(Ctrl+F). 우상단, 매치 하이라이트 + 이전/다음 이동. Esc 로 닫기. -->
            <Border x:Name="FindBar" Grid.Column="0" Visibility="Collapsed"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,8,14,0" Padding="8,6"
                    Background="{DynamicResource OverlayBg}" BorderBrush="{DynamicResource BorderStrong}"
                    BorderThickness="1" CornerRadius="8">
                <StackPanel Orientation="Horizontal">
                    <TextBox x:Name="FindBox" Width="220" MinHeight="26" FontSize="{StaticResource Font.Body}"
                             Style="{StaticResource CommandInput}" Padding="8,3"
                             TextChanged="FindBox_TextChanged" PreviewKeyDown="FindBox_PreviewKeyDown"/>
                    <TextBlock x:Name="FindCount" VerticalAlignment="Center" Margin="9,0,7,0"
                               MinWidth="46" Foreground="{DynamicResource TextMuted}" FontSize="{StaticResource Font.Caption}"
                               FontFamily="{StaticResource MonoFont}" Text=""/>
                    <Button Content="▲" Style="{StaticResource DialogButton}" MinWidth="0" MinHeight="26"
                            Padding="9,0" Focusable="False" Click="FindPrev_Click" ToolTip="{loc:Str Doc.FindPrevTip}"/>
                    <Button Content="▼" Style="{StaticResource DialogButton}" MinWidth="0" MinHeight="26"
                            Padding="9,0" Margin="5,0,0,0" Focusable="False" Click="FindNext_Click" ToolTip="{loc:Str Doc.FindNextTip}"/>
                    <Button Content="✕" Style="{StaticResource DialogButton}" MinWidth="0" MinHeight="26"
                            Padding="9,0" Margin="5,0,0,0" Focusable="False" Click="FindClose_Click" ToolTip="{loc:Str Doc.FindCloseTip}"/>
                </StackPanel>
            </Border>

            <!-- 폰트 크기 실시간 표시(Ctrl+휠/Ctrl+±). 잠깐 떴다 사라짐. 마우스 입력 통과. -->
            <Border x:Name="ZoomIndicator" Grid.Column="0" Visibility="Collapsed"
                    IsHitTestVisible="False"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,10,12,0" Padding="11,6"
                    Background="{DynamicResource OverlayBg}" BorderBrush="{DynamicResource BorderStrong}"
                    BorderThickness="1" CornerRadius="7">
                <TextBlock x:Name="ZoomText" Foreground="{DynamicResource Text}"
                           FontFamily="{StaticResource MonoFont}" FontSize="{StaticResource Font.Emph}" FontWeight="Bold"/>
            </Border>
        </Grid>
    </DockPanel>
</UserControl>
