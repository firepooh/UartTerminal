<Window x:Class="UartTerminal.McpGuideDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:UartTerminal"
        Title="{loc:Str McpGuide.Title}"
        Icon="/UartTerminal.ico"
        Width="640" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource BgPanel}"
        Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource UiFont}">

    <!--
      등록 스코프는 Claude Code 쪽 개념이라 앱 어디에도 힌트가 없다 — 그래서 한 화면에 모아 설명한다.
      MessageBox 가 아닌 이유: 주소와 명령을 드래그해 복사할 수 있어야 하고, 복사 버튼이 필요하다.
      내용이 길어 스크롤을 두되 창은 내용에 맞춘다(SizeToContent) — 화면을 넘으면 코드가 MaxHeight 로 잘라 준다.
    -->
    <DockPanel Margin="18">

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal"
                    HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{loc:Str Common.Close}" Style="{StaticResource GhostButton}" IsCancel="True"/>
            <Button Content="{loc:Str McpGuide.Copy}" x:Name="CopyButton"
                    Style="{StaticResource SendButton}"
                    MinWidth="86" MinHeight="30" Margin="8,0,0,0" IsDefault="True" Click="Copy_Click"/>
        </StackPanel>

        <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,10,0">

                <!-- 1. 전송 방식 -->
                <TextBlock Text="{loc:Str McpGuide.S1Head}" Style="{StaticResource SectionHead}"/>
                <TextBlock Text="{loc:Str McpGuide.S1Body}" Style="{StaticResource HintText}"
                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                <Border Style="{StaticResource InsetPanel}" Margin="0,8,0,0" Padding="12,10">
                    <TextBox x:Name="UrlBox" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                             Foreground="{DynamicResource Green}"
                             FontFamily="{StaticResource MonoFont}"
                             FontSize="{StaticResource Font.Body}"
                             Padding="0" TextWrapping="NoWrap"/>
                </Border>
                <TextBlock Text="{loc:Str McpGuide.S1Note}" Style="{StaticResource HintText}"
                           TextWrapping="Wrap" Margin="0,8,0,0"/>

                <!-- 2. 스코프 -->
                <TextBlock Text="{loc:Str McpGuide.S2Head}" Style="{StaticResource SectionHead}" Margin="0,20,0,0"/>
                <TextBlock Text="{loc:Str McpGuide.S2Body}" Style="{StaticResource HintText}" Margin="0,6,0,0"/>

                <Border Style="{StaticResource InsetPanel}" Margin="0,8,0,0" Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- 권장안은 강조색 + 꼬리표로 한눈에 구분한다 -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="{loc:Str McpGuide.ScopeUser}"
                                   FontSize="{StaticResource Font.Caption}" FontWeight="SemiBold"
                                   Foreground="{DynamicResource Green}" Margin="0,0,14,0"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                            <TextBlock Text="{loc:Str McpGuide.ScopeUserWhat}" TextWrapping="Wrap"
                                       FontSize="{StaticResource Font.Caption}"/>
                            <Border Background="{DynamicResource Accent}" CornerRadius="4"
                                    Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="{loc:Str McpGuide.Recommended}"
                                           FontSize="{StaticResource Font.Glyph}"
                                           Foreground="{DynamicResource OnAccent}"/>
                            </Border>
                        </StackPanel>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="{loc:Str McpGuide.ScopeLocal}"
                                   FontSize="{StaticResource Font.Caption}"
                                   Foreground="{DynamicResource TextDim}" Margin="0,8,14,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{loc:Str McpGuide.ScopeLocalWhat}"
                                   TextWrapping="Wrap" Margin="0,8,0,0"
                                   FontSize="{StaticResource Font.Caption}"
                                   Foreground="{DynamicResource TextMuted}"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="{loc:Str McpGuide.ScopeProject}"
                                   FontSize="{StaticResource Font.Caption}"
                                   Foreground="{DynamicResource TextDim}" Margin="0,8,14,0"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{loc:Str McpGuide.ScopeProjectWhat}"
                                   TextWrapping="Wrap" Margin="0,8,0,0"
                                   FontSize="{StaticResource Font.Caption}"
                                   Foreground="{DynamicResource TextMuted}"/>
                    </Grid>
                </Border>

                <TextBlock Text="{loc:Str McpGuide.S2Cmd}" Style="{StaticResource HintText}" Margin="0,12,0,0"/>
                <Border Style="{StaticResource InsetPanel}" Margin="0,6,0,0" Padding="12,10">
                    <TextBox x:Name="CommandBox" IsReadOnly="True" BorderThickness="0" Background="Transparent"
                             Foreground="{DynamicResource Text}"
                             FontFamily="{StaticResource MonoFont}"
                             FontSize="{StaticResource Font.Caption}"
                             Padding="0" TextWrapping="Wrap"/>
                </Border>

                <!-- 3. 왜 user 인가 -->
                <TextBlock Text="{loc:Str McpGuide.S3Head}" Style="{StaticResource SectionHead}" Margin="0,20,0,0"/>
                <TextBlock Text="{loc:Str McpGuide.S3Body}" Style="{StaticResource HintText}"
                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                <StackPanel Margin="0,8,0,0">
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="·" Margin="2,0,8,0" Foreground="{DynamicResource TextMuted}"/>
                        <TextBlock Grid.Column="1" Text="{loc:Str McpGuide.S3B1}" TextWrapping="Wrap"
                                   FontSize="{StaticResource Font.Caption}"/>
                    </Grid>
                    <Grid Margin="0,0,0,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="·" Margin="2,0,8,0" Foreground="{DynamicResource TextMuted}"/>
                        <TextBlock Grid.Column="1" Text="{loc:Str McpGuide.S3B2}" TextWrapping="Wrap"
                                   FontSize="{StaticResource Font.Caption}"/>
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="·" Margin="2,0,8,0" Foreground="{DynamicResource TextMuted}"/>
                        <TextBlock Grid.Column="1" Text="{loc:Str McpGuide.S3B3}" TextWrapping="Wrap"
                                   FontSize="{StaticResource Font.Caption}"/>
                    </Grid>
                </StackPanel>

                <!-- 4. 동작 조건 -->
                <TextBlock Text="{loc:Str McpGuide.S4Head}" Style="{StaticResource SectionHead}" Margin="0,20,0,0"/>
                <Border Style="{StaticResource InsetPanel}" Margin="0,8,0,0" Padding="14,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0" Text="1" Margin="0,0,10,0"
                                   Foreground="{DynamicResource TextMuted}"
                                   FontSize="{StaticResource Font.Caption}"/>
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{loc:Str McpGuide.S4L1}"
                                   FontSize="{StaticResource Font.Caption}"/>
                        <TextBlock Grid.Row="1" Text="2" Margin="0,6,10,0"
                                   Foreground="{DynamicResource TextMuted}"
                                   FontSize="{StaticResource Font.Caption}"/>
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{loc:Str McpGuide.S4L2}" Margin="0,6,0,0"
                                   FontSize="{StaticResource Font.Caption}"/>
                        <TextBlock Grid.Row="2" Text="3" Margin="0,6,10,0"
                                   Foreground="{DynamicResource TextMuted}"
                                   FontSize="{StaticResource Font.Caption}"/>
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{loc:Str McpGuide.S4L3}" Margin="0,6,0,0"
                                   TextWrapping="Wrap" FontSize="{StaticResource Font.Caption}"/>
                    </Grid>
                </Border>
                <TextBlock Text="{loc:Str McpGuide.S4Note}" Style="{StaticResource HintText}"
                           TextWrapping="Wrap" Margin="0,8,0,0"/>

                <!-- 5. 주의 -->
                <TextBlock Text="{loc:Str McpGuide.S5Head}" Style="{StaticResource SectionHead}" Margin="0,20,0,0"/>
                <TextBlock Text="{loc:Str McpGuide.S5B1}" Style="{StaticResource HintText}"
                           TextWrapping="Wrap" Margin="0,6,0,0"/>
                <TextBlock Text="{loc:Str McpGuide.S5B2}" Style="{StaticResource HintText}"
                           TextWrapping="Wrap" Margin="0,8,0,0"/>
                <TextBlock Text="{loc:Str McpGuide.S5B3}" Style="{StaticResource HintText}"
                           TextWrapping="Wrap" Margin="0,8,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
