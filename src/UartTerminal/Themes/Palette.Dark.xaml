<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         UartTerminal — 다크 팔레트 (GitHub-dark). 앱의 유일한 팔레트다(테마 전환 없음).
         이 파일에는 <b>색과 브러시만</b> 둔다 — 타이포 토큰과 스타일은 Controls.xaml 에 있다.
         색이 필요하면 화면에 리터럴로 쓰지 말고 여기에 키를 추가한다(규약 테스트가 검사한다).
         ============================================================ -->
    <!-- ===== Color palette ===== -->
    <Color x:Key="C.Bg">#FF0D1117</Color>
    <Color x:Key="C.BgDeep">#FF0A0D12</Color>
    <Color x:Key="C.BgPanel">#FF0B0F16</Color>
    <Color x:Key="C.Surface">#FF11161F</Color>
    <Color x:Key="C.SurfaceHover">#FF1A2130</Color>
    <!-- 경계선 3종. WCAG 는 'UI 컴포넌트 경계' 에 3:1 을 요구한다 —
         원래 값(Border #1C2433 = 1.22:1, BorderStrong #263141 = 1.44:1)은 사실상 보이지 않아
         빈 체크박스·콤보 테두리가 배경에 묻었다. 용도를 나눠 각각 목표를 다르게 잡는다:
           Border        = 장식용 구분선(패널 경계) — 구조가 읽히는 정도
           BorderStrong  = 상호작용 컨트롤 윤곽    — 3:1 이상(필수)
           BorderFocus   = 포커스/호버 강조 -->
    <Color x:Key="C.Border">#FF41506A</Color>
    <Color x:Key="C.BorderStrong">#FF6E7A8C</Color>
    <Color x:Key="C.BorderFocus">#FF8B97A8</Color>
    <Color x:Key="C.TabIdle">#FF0F141D</Color>
    <Color x:Key="C.Text">#FFE6EDF5</Color>
    <Color x:Key="C.TextDim">#FFA9B4C4</Color>
    <Color x:Key="C.TextMuted">#FF8B97A8</Color>
    <!-- 보조 문구용. 원래 #5B6675 는 3.25:1 로 작은 글씨에 부족했다 -->
    <Color x:Key="C.TextFaint">#FF7D8899</Color>
    <Color x:Key="C.Accent">#FF2F81F7</Color>
    <Color x:Key="C.AccentDeep">#FF1F6FEB</Color>
    <!-- 강조 배경(선택 행·기본 버튼·체크 표시) 위에 얹는 글자·아이콘 색.
         예전에는 이 값이 "White" 리터럴로 7곳에 흩어져 있어서, AccentDeep 을 밝게 조정하면
         대비가 조용히 무너지는데 팔레트 검사에는 걸리지 않았다(리터럴은 팔레트 밖이라서). -->
    <Color x:Key="C.OnAccent">#FFFFFFFF</Color>
    <Color x:Key="C.Green">#FF2EA043</Color>
    <Color x:Key="C.GreenBright">#FF3FB950</Color>
    <Color x:Key="C.Blue">#FF58A6FF</Color>
    <Color x:Key="C.Amber">#FFD29922</Color>
    <Color x:Key="C.Red">#FFF85149</Color>
    <Color x:Key="C.Purple">#FFBC8CFF</Color>
    <Color x:Key="C.State">#FFF0883E</Color>
    <!-- 상태 점(연결 안 됨). 원래 #4B5563 은 2.50:1 로 잘 보이지 않았다 -->
    <Color x:Key="C.Idle">#FF6B7688</Color>

    <!-- ===== Brushes ===== -->
    <SolidColorBrush x:Key="Bg"            Color="{StaticResource C.Bg}"/>
    <SolidColorBrush x:Key="BgDeep"        Color="{StaticResource C.BgDeep}"/>
    <SolidColorBrush x:Key="BgPanel"       Color="{StaticResource C.BgPanel}"/>
    <SolidColorBrush x:Key="Surface"       Color="{StaticResource C.Surface}"/>
    <SolidColorBrush x:Key="SurfaceHover"  Color="{StaticResource C.SurfaceHover}"/>
    <SolidColorBrush x:Key="BorderBrush2"  Color="{StaticResource C.Border}"/>
    <SolidColorBrush x:Key="BorderStrong"  Color="{StaticResource C.BorderStrong}"/>
    <SolidColorBrush x:Key="BorderFocus"   Color="{StaticResource C.BorderFocus}"/>
    <SolidColorBrush x:Key="TabIdle"       Color="{StaticResource C.TabIdle}"/>
    <SolidColorBrush x:Key="Text"          Color="{StaticResource C.Text}"/>
    <SolidColorBrush x:Key="TextDim"       Color="{StaticResource C.TextDim}"/>
    <SolidColorBrush x:Key="TextMuted"     Color="{StaticResource C.TextMuted}"/>
    <SolidColorBrush x:Key="TextFaint"     Color="{StaticResource C.TextFaint}"/>
    <SolidColorBrush x:Key="Accent"        Color="{StaticResource C.Accent}"/>
    <SolidColorBrush x:Key="AccentDeep"    Color="{StaticResource C.AccentDeep}"/>
    <SolidColorBrush x:Key="OnAccent"      Color="{StaticResource C.OnAccent}"/>
    <SolidColorBrush x:Key="Green"         Color="{StaticResource C.Green}"/>
    <SolidColorBrush x:Key="GreenBright"   Color="{StaticResource C.GreenBright}"/>
    <SolidColorBrush x:Key="Blue"          Color="{StaticResource C.Blue}"/>
    <SolidColorBrush x:Key="Amber"         Color="{StaticResource C.Amber}"/>
    <SolidColorBrush x:Key="Red"           Color="{StaticResource C.Red}"/>
    <SolidColorBrush x:Key="Purple"        Color="{StaticResource C.Purple}"/>
    <SolidColorBrush x:Key="StateBrush"    Color="{StaticResource C.State}"/>
    <SolidColorBrush x:Key="Idle"          Color="{StaticResource C.Idle}"/>

    <!-- 스크롤 손잡이(3:1 이상). 원래 #363C46 은 1.67:1 로 어디를 잡는지 보이지 않았다 -->
    <SolidColorBrush x:Key="ScrollThumb"      Color="#FF5F6A7B"/>
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#FF8B97A8"/>

    <!-- ===== 코드에서 쓰는 브러시 =====
         셸(분할 패널·상태 점)과 터미널 렌더러가 쓰던 색을 코드에 복사해 두면
         테마를 고쳐도 그쪽은 옛 색을 계속 써서 화면이 어긋난다(실제로 그랬다).
         전부 테마 키로 옮겨 '색은 테마에만 있다' 는 규칙을 세운다. -->
    <SolidColorBrush x:Key="PanelBorderInactive" Color="{StaticResource C.Border}"/>
    <SolidColorBrush x:Key="PanelHeaderBg"       Color="{StaticResource C.TabIdle}"/>
    <SolidColorBrush x:Key="ContentBg"           Color="{StaticResource C.Bg}"/>
    <SolidColorBrush x:Key="SplitterBrush"       Color="{StaticResource C.Border}"/>
    <SolidColorBrush x:Key="TitleActiveFg"       Color="{StaticResource C.Text}"/>
    <SolidColorBrush x:Key="TitleInactiveFg"     Color="{StaticResource C.TextMuted}"/>
    <SolidColorBrush x:Key="DotConnected"        Color="{StaticResource C.GreenBright}"/>
    <SolidColorBrush x:Key="DotIdle"             Color="{StaticResource C.Idle}"/>
    <SolidColorBrush x:Key="DotReconnecting"     Color="{StaticResource C.Amber}"/>
    <SolidColorBrush x:Key="DotReleased"         Color="{StaticResource C.Purple}"/>
    <SolidColorBrush x:Key="PromptActive"        Color="{StaticResource C.GreenBright}"/>
    <SolidColorBrush x:Key="PromptIdle"          Color="{StaticResource C.Green}"/>

    <!-- 오버레이(찾기 바·줌 표시기) 배경. 반투명이라 Color 가 아닌 브러시로 둔다.
         예전에는 XAML 에 #F20B0F16 을 직접 박아 라이트 테마에서 검은 알약이 남았다. -->
    <SolidColorBrush x:Key="OverlayBg" Color="#F20B0F16"/>

    <!-- 터미널 렌더러 -->
    <Color x:Key="C.TermFg">#FFE6EDF5</Color>
    <Color x:Key="C.TermBg">#FF0D1117</Color>
    <Color x:Key="C.TermCursor">#FF3FB950</Color>
    <!-- 선택 영역은 글자 위에 겹치므로 반투명(알파 0x66)이어야 한다 -->
    <Color x:Key="C.TermSelection">#662F81F7</Color>
    <Color x:Key="C.TermTimestamp">#FF8B97A8</Color>
    <Color x:Key="C.TermSearchMatch">#FF4B4612</Color>
    <Color x:Key="C.TermSearchCurrent">#FF8A6600</Color>
    <Color x:Key="C.TermMeta">#FFBC8CFF</Color>

    <!-- ===== ANSI 16색 =====
         원래 "표준값이라 코드에 둔다"(TerminalPalette.Ansi16)였는데, 그래서 테마를 따라오지 않았다.
         흰 배경에서 초록 2.16:1 · 노랑 1.70:1 · 흰색 1.26:1 로 ESP-IDF 로그가 읽히지 않았다
         (16색 중 11개가 4.5:1 미달). 실제 터미널들이 라이트/다크용 팔레트를 따로 갖는 이유다.
         다크는 xterm 표준을 유지하되 red 만 올렸다 — #CD0000 은 3.24:1 로
         ESP_LOGE(가장 중요한 줄)가 16색 중 최저 대비였다. bold 승격(red→bright red)이
         더 밝아지도록 bright red 도 함께 올린다. 두 값 모두 GitHub 계열. -->
    <Color x:Key="C.Ansi0">#FF000000</Color>
    <Color x:Key="C.Ansi1">#FFE5534B</Color>
    <Color x:Key="C.Ansi2">#FF00CD00</Color>
    <Color x:Key="C.Ansi3">#FFCDCD00</Color>
    <Color x:Key="C.Ansi4">#FF2472C8</Color>
    <Color x:Key="C.Ansi5">#FFCD00CD</Color>
    <Color x:Key="C.Ansi6">#FF00CDCD</Color>
    <Color x:Key="C.Ansi7">#FFE5E5E5</Color>
    <Color x:Key="C.Ansi8">#FF7F7F7F</Color>
    <Color x:Key="C.Ansi9">#FFFF7B72</Color>
    <Color x:Key="C.Ansi10">#FF00FF00</Color>
    <Color x:Key="C.Ansi11">#FFFFFF00</Color>
    <Color x:Key="C.Ansi12">#FF5C5CFF</Color>
    <Color x:Key="C.Ansi13">#FFFF00FF</Color>
    <Color x:Key="C.Ansi14">#FF00FFFF</Color>
    <Color x:Key="C.Ansi15">#FFFFFFFF</Color>

</ResourceDictionary>
