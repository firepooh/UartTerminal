<Window x:Class="UartTerminal.TextPromptDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:UartTerminal"
        Title="UartTerminal"
        Icon="/UartTerminal.ico"
        Width="440" SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Background="{DynamicResource Bg}"
        Foreground="{DynamicResource Text}"
        FontFamily="{StaticResource UiFont}">
    <StackPanel Margin="16">
        <TextBlock x:Name="PromptText" Margin="2,0,0,10" Style="{StaticResource HintText}"/>
        <TextBox x:Name="InputBox" Style="{StaticResource CommandInput}" MaxLength="40"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="{loc:Str Common.Ok}" Style="{StaticResource SendButton}"
                    MinWidth="86" MinHeight="30" Margin="0,0,8,0" IsDefault="True" Click="Ok_Click"/>
            <Button Content="{loc:Str Common.Cancel}" Style="{StaticResource DialogButton}" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
